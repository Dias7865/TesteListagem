-- =====================================================
-- CÓDIGO SQL COMPLETO - SUPABASE
-- Tarefas, Integradores e Intensidades
-- =====================================================

-- 1. LIMPEZA
DROP FUNCTION IF EXISTS verificar_senha(text);
DROP TABLE IF EXISTS tarefas;
DROP TABLE IF EXISTS integradores;
DROP TABLE IF EXISTS intensidades;
DROP TABLE IF EXISTS configuracoes;
DROP TABLE IF EXISTS trfsconcluidas;

-- =====================================================
-- 2. TABELA DE CONFIGURAÇÕES (senha)
-- =====================================================
CREATE TABLE configuracoes (
    id uuid DEFAULT gen_random_uuid() PRIMARY KEY,
    chave varchar(50) NOT NULL,
    valor varchar(100) NOT NULL,
    created_at timestamp with time zone DEFAULT timezone('utc'::text, now()) NOT NULL
);

INSERT INTO configuracoes (chave, valor) VALUES ('senha_verificacao', 'jkl');

-- =====================================================
-- 3. TABELA DE INTEGRADORES (criada primeiro, pois tarefas referencia)
-- =====================================================
CREATE TABLE integradores (
    id uuid DEFAULT gen_random_uuid() PRIMARY KEY,
    nome varchar(25) NOT NULL,
    integrador_cpf varchar(25) NOT NULL,
    created_at timestamp with time zone DEFAULT timezone('utc'::text, now()) NOT NULL
);

-- =====================================================
-- 4. TABELA DE INTENSIDADES
-- =====================================================


CREATE TABLE intensidades (
    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    status_nome TEXT UNIQUE NOT NULL,
    valor_intensidade INT DEFAULT 0,
    updated_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);


-- =====================================================
-- 5. TABELA DE TAREFAS (com Intg_id e intensidade_id)
-- =====================================================
CREATE TABLE tarefas (
    id uuid DEFAULT gen_random_uuid() PRIMARY KEY,
    nome varchar(50) NOT NULL,
    tipo varchar(30),
    descricao text,
    created_at timestamp with time zone DEFAULT timezone('utc'::text, now()) NOT NULL,
    intg_id uuid REFERENCES integradores(id),
    status varchar(30) CHECK (status IN ('concluído', 'em progresso', 'aguardando equatorial', 'não iniciado', 'faltam dados')),
    data_para_termino date
);


CREATE TABLE trfsconcluidas (
    id uuid DEFAULT gen_random_uuid() PRIMARY KEY,
    nome varchar(50) NOT NULL,
    tipo varchar(30),
    descricao text,
    intg_fz varchar(25),
    data_finalizado date
);




