-- =====================================================
-- 5. TABELA DE TAREFAS (com Intg_id e intensidade_id)
-- =====================================================
CREATE TABLE tarefas (
    id uuid DEFAULT gen_random_uuid() PRIMARY KEY,
    nome varchar(50) NOT NULL,
    tipo varchar(30),
    descricao text,
    created_at timestamp with time zone DEFAULT timezone('utc'::text, now()) NOT NULL,
    intg_id uuid REFERENCES integradores(id),
    intensidade_id uuid REFERENCES intensidades(id)
);

