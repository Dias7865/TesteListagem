ALTER TABLE configuracoes ENABLE ROW LEVEL SECURITY;
ALTER TABLE tarefas ENABLE ROW LEVEL SECURITY;
ALTER TABLE integradores ENABLE ROW LEVEL SECURITY;
ALTER TABLE intensidades ENABLE ROW LEVEL SECURITY;
ALTER TABLE trfsconcluidas ENABLE ROW LEVEL SECURITY;


-- SELECT
CREATE POLICY "Permitir leitura pública de tarefas" ON tarefas FOR SELECT USING (true);
CREATE POLICY "Permitir leitura pública de integradores" ON integradores FOR SELECT USING (true);
CREATE POLICY "Permitir leitura pública de intensidades" ON intensidades FOR SELECT USING (true);
CREATE POLICY "Permitir leitura pública de trfsconcluidas" ON trfsconcluidas FOR SELECT USING (true);
CREATE POLICY "Bloquear leitura direta de configuracoes" ON configuracoes FOR SELECT USING (false);



-- INSERT
CREATE POLICY "Permitir inserção pública de tarefas" ON tarefas FOR INSERT WITH CHECK (true);
CREATE POLICY "Permitir inserção pública de integradores" ON integradores FOR INSERT WITH CHECK (true);
CREATE POLICY "Permitir inserção pública de trfsconcluidas" ON trfsconcluidas FOR INSERT WITH CHECK (true);

-- UPDATE
CREATE POLICY "Permitir atualização pública de tarefas" ON tarefas FOR UPDATE USING (true) WITH CHECK (true);
CREATE POLICY "Permitir atualização pública de integradores" ON integradores FOR UPDATE USING (true) WITH CHECK (true);
CREATE POLICY "Permitir atualização pública de trfsconcluidas" ON trfsconcluidas FOR UPDATE USING (true) WITH CHECK (true);

-- DELETE
CREATE POLICY "Permitir remoção pública de tarefas" ON tarefas FOR DELETE USING (true);
CREATE POLICY "Permitir remoção pública de integradores" ON integradores FOR DELETE USING (true);
CREATE POLICY "Permitir remoção pública de trfsconcluidas" ON trfsconcluidas FOR DELETE USING (true);

-- =====================================================
-- 8. FUNÇÃO DE SENHA
-- =====================================================
CREATE OR REPLACE FUNCTION verificar_senha(texto_inserido text)
RETURNS boolean 
LANGUAGE plpgsql 
SECURITY DEFINER
AS $$
DECLARE
    senha_correta text;
BEGIN
    SELECT valor INTO senha_correta 
    FROM configuracoes 
    WHERE chave = 'senha_verificacao' 
    LIMIT 1;
    RETURN texto_inserido = senha_correta;
END;
$$;

-- =====================================================
-- 9. PERMISSÕES
-- =====================================================
GRANT EXECUTE ON FUNCTION verificar_senha(text) TO anon;
GRANT SELECT, INSERT, UPDATE, DELETE ON tarefas TO anon;
GRANT SELECT, INSERT, UPDATE, DELETE ON integradores TO anon;
GRANT SELECT, INSERT, UPDATE, DELETE ON trfsconcluidas TO anon;

GRANT SELECT ON intensidades TO anon;





CREATE OR REPLACE FUNCTION calcular_intensidades()
RETURNS VOID AS $$
BEGIN
    INSERT INTO intensidades (status_nome, valor_intensidade, updated_at)
    VALUES 
        (
            'concluído', 
            (SELECT COUNT(*) FROM tarefas WHERE LOWER(status) IN ('concluído', 'concluido')), 
            NOW()
        ),
        (
            'em progresso', 
            (SELECT COUNT(*) FROM tarefas WHERE LOWER(status) = 'em progresso'), 
            NOW()
        ),
        (
            'aguardando equatorial', 
            (SELECT COUNT(*) FROM tarefas WHERE LOWER(status) = 'aguardando equatorial'), 
            NOW()
        ),
        (
            'faltam dados', 
            (SELECT COUNT(*) FROM tarefas WHERE LOWER(status) = 'faltam dados'), 
            NOW()
        ),
        (
            'não iniciado', 
            (SELECT COUNT(*) FROM tarefas WHERE LOWER(status) = 'não iniciado'), 
            NOW()
        ),
        (
            'atrasado',  ---Não é usado----
            (SELECT COUNT(*) FROM tarefas WHERE LOWER(status) = 'atrasado'), 
            NOW()
        )
    ON CONFLICT (status_nome) 
    DO UPDATE SET 
        valor_intensidade = EXCLUDED.valor_intensidade,
        updated_at = EXCLUDED.updated_at;
END;
$$ LANGUAGE plpgsql;
















