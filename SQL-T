-- 8. Configuração de Segurança (RLS)
ALTER TABLE configuracoes ENABLE ROW LEVEL SECURITY;
ALTER TABLE arvores ENABLE ROW LEVEL SECURITY;
ALTER TABLE metais ENABLE ROW LEVEL SECURITY;

-- Políticas das tabelas de dados
CREATE POLICY "Permitir leitura pública de arvores" 
ON arvores FOR SELECT 
USING (true);

CREATE POLICY "Permitir leitura pública de metais" 
ON metais FOR SELECT 
USING (true);

-- Política da tabela de configurações: ninguém lê diretamente
CREATE POLICY "Bloquear leitura direta de configuracoes" 
ON configuracoes FOR SELECT 
USING (false);

-- 9. Função para verificar a senha (retorna true/false)
CREATE OR REPLACE FUNCTION verificar_senha(texto_inserido text)
RETURNS boolean 
LANGUAGE plpgsql 
SECURITY DEFINER
AS $$
DECLARE
    senha_correta text;
BEGIN
    -- Busca a senha armazenada no banco
    SELECT valor INTO senha_correta 
    FROM configuracoes 
    WHERE chave = 'senha_verificacao' 
    LIMIT 1;
    
    -- Compara e retorna true se estiver correta, false caso contrário
    RETURN texto_inserido = senha_correta;
END;
$$;

-- 10. Permite que usuários anônimos executem a função
GRANT EXECUTE ON FUNCTION verificar_senha(text) TO anon;
