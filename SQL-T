-- 1. Limpeza (Opcional: remove as tabelas se elas já existirem para evitar erros ao rodar novamente)
DROP TABLE IF EXISTS metais;
DROP TABLE IF EXISTS arvores;


-- 2. Criação da tabela de Árvores
CREATE TABLE arvores (
    id uuid DEFAULT gen_random_uuid() PRIMARY KEY,
    nome varchar(50) NOT NULL,
    tipo varchar(50),
    descricao text,
    created_at timestamp with time zone DEFAULT timezone('utc'::text, now()) NOT NULL
);

-- 3. Criação da tabela de Metais
CREATE TABLE metais (
    id uuid DEFAULT gen_random_uuid() PRIMARY KEY,
    nome varchar(50) NOT NULL,
    simbolo_quimico varchar(10),
    descricao text,
    created_at timestamp with time zone DEFAULT timezone('utc'::text, now()) NOT NULL
);

