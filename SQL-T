USING (false);

-- 9. Função para buscar árvores com validação de palavra-chave
CREATE OR REPLACE FUNCTION buscar_arvores_seguro(palavra_chave text)
RETURNS TABLE (
    id uuid,
    nome varchar(50),
    tipo varchar(50),
    descricao text,
    created_at timestamp with time zone
) 
LANGUAGE plpgsql 
SECURITY DEFINER
AS $$
DECLARE
    chave_correta text;
BEGIN
    -- Busca a palavra-chave correta do banco
    SELECT palavra_chave INTO chave_correta FROM configuracoes LIMIT 1;
    
    -- Verifica se a palavra-chave fornecida está correta
    IF palavra_chave = chave_correta THEN
        -- Retorna todos os dados das árvores
        RETURN QUERY 
        SELECT a.id, a.nome, a.tipo, a.descricao, a.created_at 
        FROM arvores a;
    ELSE
        -- Retorna tabela vazia se a palavra-chave estiver errada
        RETURN;
    END IF;
END;
$$;

-- 10. Função para buscar metais com validação de palavra-chave
CREATE OR REPLACE FUNCTION buscar_metais_seguro(palavra_chave text)
RETURNS TABLE (
    id uuid,
    nome varchar(50),
    simbolo_quimico varchar(10),
    descricao text,
    created_at timestamp with time zone
) 
LANGUAGE plpgsql 
SECURITY DEFINER
AS $$
DECLARE
    chave_correta text;
BEGIN
    -- Busca a palavra-chave correta do banco
    SELECT palavra_chave INTO chave_correta FROM configuracoes LIMIT 1;
    
    -- Verifica se a palavra-chave fornecida está correta
    IF palavra_chave = chave_correta THEN
        -- Retorna todos os dados dos metais
        RETURN QUERY 
        SELECT m.id, m.nome, m.simbolo_quimico, m.descricao, m.created_at 
        FROM metais m;
    ELSE
        -- Retorna tabela vazia se a palavra-chave estiver errada
        RETURN;
    END IF;
END;
$$;

