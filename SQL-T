-- =====================================================
-- 4. FUNÇÕES E PROCEDURES (RPCs)
-- =====================================================

-- Validação de Senha
CREATE OR REPLACE FUNCTION verificar_senha(texto_inserido text)
RETURNS boolean 
LANGUAGE plpgsql 
SECURITY DEFINER
AS $$
DECLARE
    senha_correta text;
BEGIN
    SELECT valor INTO senha_correta 
    FROM configuracoes 
    WHERE chave = 'senha_verificacao' 
    LIMIT 1;
    RETURN texto_inserido = senha_correta;
END;
$$;

-- Recálculo de Intensidades por Status (com permissão de superusuário)
CREATE OR REPLACE FUNCTION calcular_intensidades()
RETURNS VOID 
LANGUAGE plpgsql 
SECURITY DEFINER
AS $$
BEGIN
    INSERT INTO intensidades (status_nome, valor_intensidade, updated_at)
    VALUES 
        (   'concluído', (SELECT COUNT(*) FROM tarefas WHERE LOWER(status) IN ('concluído', 'concluido')), NOW() ),
        (   'em progresso', (SELECT COUNT(*) FROM tarefas WHERE LOWER(status) = 'em progresso'), NOW() ),
        (   'aguardando equatorial', (SELECT COUNT(*) FROM tarefas WHERE LOWER(status) = 'aguardando equatorial'), NOW() ),
        (   'faltam dados', (SELECT COUNT(*) FROM tarefas WHERE LOWER(status) = 'faltam dados'), NOW() ),
        (   'reprovado pela equatorial', (SELECT COUNT(*) FROM tarefas WHERE LOWER(status) = 'reprovado pela equatorial'), NOW() )
    ON CONFLICT (status_nome) 
    DO UPDATE SET 
        valor_intensidade = EXCLUDED.valor_intensidade,
        updated_at = EXCLUDED.updated_at;
END;
$$;

-- Handler para Trigger Automática
CREATE OR REPLACE FUNCTION trg_atualizar_intensidades()
RETURNS TRIGGER AS $$
BEGIN
    PERFORM calcular_intensidades();
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;



-- =====================================================
-- 5. TRIGGERS (GATILHOS AUTOMÁTICOS)
-- =====================================================

CREATE TRIGGER trigger_atualizar_intensidades
AFTER INSERT OR UPDATE OR DELETE ON tarefas
FOR EACH STATEMENT
EXECUTE FUNCTION trg_atualizar_intensidades();

