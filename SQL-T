-- 1. Limpeza (remove tabelas e funções se já existirem)
DROP FUNCTION IF EXISTS buscar_arvores_seguro(text);
DROP FUNCTION IF EXISTS buscar_metais_seguro(text);
DROP TABLE IF EXISTS metais;
DROP TABLE IF EXISTS arvores;
DROP TABLE IF EXISTS configuracoes;

-- 2. Criação da tabela de configurações (armazena a palavra-chave)
CREATE TABLE configuracoes (
    id uuid DEFAULT gen_random_uuid() PRIMARY KEY,
    palavra_chave varchar(100) NOT NULL,
    created_at timestamp with time zone DEFAULT timezone('utc'::text, now()) NOT NULL
);

-- 3. Insere a palavra-chave secreta
INSERT INTO configuracoes (palavra_chave) VALUES ('Certo');

-- 4. Criação da tabela de Árvores
CREATE TABLE arvores (
    id uuid DEFAULT gen_random_uuid() PRIMARY KEY,
    nome varchar(50) NOT NULL,
    tipo varchar(50),
    descricao text,
    created_at timestamp with time zone DEFAULT timezone('utc'::text, now()) NOT NULL
);

-- 5. Criação da tabela de Metais
CREATE TABLE metais (
