-- 6. Configuração de Segurança (RLS)
ALTER TABLE arvores ENABLE ROW LEVEL SECURITY;
ALTER TABLE metais ENABLE ROW LEVEL SECURITY;

CREATE POLICY "Permitir leitura pública de arvores" 
ON arvores FOR SELECT 
USING (true);

CREATE POLICY "Permitir leitura pública de metais" 
ON metais FOR SELECT 
USING (true);
