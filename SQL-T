-- 6. Configuração de Segurança (Row Level Security - RLS)
-- O Supabase ativa o RLS por padrão. Se não criarmos uma política, sua API retornará "0 resultados".
-- Esta política permite que QUALQUER pessoa leia os dados (ideal para testes de integração).

ALTER TABLE arvores ENABLE ROW LEVEL SECURITY;
ALTER TABLE metais ENABLE ROW LEVEL SECURITY;

CREATE POLICY "Permitir leitura pública de arvores" 
ON arvores FOR SELECT 
USING (true);

CREATE POLICY "Permitir leitura pública de metais" 
ON metais FOR SELECT 
USING (true);



CREATE OR REPLACE FUNCTION buscar_arvores_seguro(palavra_chave text)
RETURNS SETOF arvores AS $$
BEGIN
    IF palavra_chave = 'Certo' THEN
        RETURN QUERY SELECT * FROM arvores;
    ELSE
        RAISE EXCEPTION 'Palavra-chave incorreta';
    END IF;
END;
$$ LANGUAGE plpgsql SECURITY DEFINER;
