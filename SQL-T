-- =====================================================
-- 1. LIMPEZA DE ESTRUTURAS EXISTENTES
-- =====================================================

-- Apagar tabelas com CASCADE remove automaticamente triggers e FKs vinculadas
DROP TABLE IF EXISTS configuracoes CASCADE;
DROP TABLE IF EXISTS integradores CASCADE;
DROP TABLE IF EXISTS intensidades CASCADE;
DROP TABLE IF EXISTS tarefas CASCADE;
DROP TABLE IF EXISTS trfsconcluidas CASCADE;
DROP TABLE IF EXISTS pendenciastbl CASCADE;

-- Apagar funções
DROP FUNCTION IF EXISTS trg_atualizar_intensidades() CASCADE;
DROP FUNCTION IF EXISTS calcular_intensidades() CASCADE;
DROP FUNCTION IF EXISTS verificar_senha(text) CASCADE;



-- =====================================================
-- 2. CRIAÇÃO DAS TABELAS
-- =====================================================

CREATE TABLE configuracoes (
    id uuid DEFAULT gen_random_uuid() PRIMARY KEY,
    chave varchar(50) NOT NULL,
    valor varchar(100) NOT NULL,
    created_at timestamp with time zone DEFAULT timezone('utc'::text, now()) NOT NULL
);

CREATE TABLE integradores (
    id uuid DEFAULT gen_random_uuid() PRIMARY KEY,
    nome varchar(25) NOT NULL,
    integrador_cpf varchar(25) NOT NULL,
    integrador_num varchar(20) NOT NULL,
    created_at timestamp with time zone DEFAULT timezone('utc'::text, now()) NOT NULL
);

CREATE TABLE intensidades (
    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    status_nome TEXT UNIQUE NOT NULL,
    valor_intensidade INT DEFAULT 0,
    updated_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

CREATE TABLE tarefas (
    id uuid DEFAULT gen_random_uuid() PRIMARY KEY,
    nome varchar(50) NOT NULL,
    tipo varchar(30),
    descricao text,
    created_at timestamp with time zone DEFAULT timezone('utc'::text, now()) NOT NULL,
    intg_id uuid REFERENCES integradores(id),
    status varchar(30) CHECK (status IN ('concluído', 'em progresso', 'aguardando equatorial', 'faltam dados', 'reprovado pela equatorial')),
    data_para_termino date,
    endereco text,
    data_inicio_obra date,
    status_material varchar(20) CHECK (status_material IN ('Falta', 'Arranjado')),
    materiais_faltando text[],
    relatorio_atividades text
);

CREATE TABLE trfsconcluidas (
    id uuid DEFAULT gen_random_uuid() PRIMARY KEY,
    nome varchar(50) NOT NULL,
    tipo varchar(30),
    descricao text,
    intg_fz varchar(25),
    data_finalizado date,
    endereco text,
    data_inicio_obra date,
    relatorio_atividades text
);

CREATE TABLE pendenciastbl (
    id uuid DEFAULT gen_random_uuid() PRIMARY KEY,
    tarefa_id uuid REFERENCES tarefas(id) ON DELETE CASCADE,
    texto_lista text NOT NULL,
    data_lista date
);



