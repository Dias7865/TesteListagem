<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Leitor de Dados - Árvores e Metais</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
        }

        h1 {
            text-align: center;
            color: white;
            margin-bottom: 30px;
            font-size: 2.5rem;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
        }

        .section {
            background: white;
            border-radius: 12px;
            padding: 30px;
            margin-bottom: 30px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
        }

        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            border-bottom: 2px solid #f0f0f0;
            padding-bottom: 15px;
        }

        h2 {
            color: #333;
            font-size: 1.8rem;
        }

        .btn {
            padding: 12px 24px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-size: 16px;
            font-weight: bold;
            transition: transform 0.2s, box-shadow 0.2s;
        }

        .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4);
        }

        .btn:active {
            transform: translateY(0);
        }

        .btn:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }

        .loading {
            text-align: center;
            padding: 20px;
            color: #667eea;
            font-size: 1.1rem;
        }

        .error {
            background: #fee;
            border: 1px solid #fcc;
            color: #c33;
            padding: 15px;
            border-radius: 8px;
            margin-top: 15px;
        }

        .cards-container {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 20px;
            margin-top: 20px;
        }

        .card {
            background: #f9f9f9;
            border-radius: 10px;
            padding: 20px;
            border-left: 4px solid #667eea;
            transition: transform 0.2s, box-shadow 0.2s;
        }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 5px 20px rgba(0,0,0,0.1);
        }

        .card h3 {
            color: #333;
            margin-bottom: 10px;
            font-size: 1.4rem;
        }

        .card p {
            color: #666;
            margin: 8px 0;
            line-height: 1.6;
        }

        .card .label {
            font-weight: bold;
            color: #764ba2;
        }

        .badge {
            display: inline-block;
            background: #667eea;
            color: white;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.85rem;
            margin-top: 8px;
        }

        .empty-state {
            text-align: center;
            padding: 40px;
            color: #999;
        }

        .stats {
            display: flex;
            gap: 20px;
            margin-top: 15px;
            flex-wrap: wrap;
        }

        .stat-box {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 15px 25px;
            border-radius: 8px;
            text-align: center;
        }

        .stat-number {
            font-size: 2rem;
            font-weight: bold;
            display: block;
        }

        .stat-label {
            font-size: 0.9rem;
            opacity: 0.9;
        }

        /* Estilos da caixa de verificação */
        .verificacao-container {
            display: flex;
            gap: 10px;
            align-items: center;
            margin-top: 15px;
        }

        .verificacao-container input {
            flex: 1;
            padding: 12px 16px;
            border: 2px solid #e0e0e0;
            border-radius: 8px;
            font-size: 16px;
            transition: border-color 0.3s;
        }

        .verificacao-container input:focus {
            outline: none;
            border-color: #667eea;
        }

        .verificacao-container button {
            padding: 12px 24px;
            white-space: nowrap;
        }

        .mensagem-resultado {
            margin-top: 15px;
            padding: 15px 20px;
            border-radius: 8px;
            font-size: 1.2rem;
            font-weight: bold;
            text-align: center;
            display: none;
            animation: fadeIn 0.3s ease-in-out;
        }

        .mensagem-sucesso {
            background: #e8f5e9;
            border: 2px solid #4caf50;
            color: #2e7d32;
        }

        .mensagem-erro {
            background: #fce4ec;
            border: 2px solid #f44336;
            color: #c62828;
        }

        /* Classe para esconder seções */
        .hidden {
            display: none !important;
        }

        /* Animação de entrada das seções */
        @keyframes slideIn {
            from { 
                opacity: 0; 
                transform: translateY(20px); 
            }
            to { 
                opacity: 1; 
                transform: translateY(0); 
            }
        }

        .section-revealed {
            animation: slideIn 0.5s ease-out;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(-5px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>🌳 Leitor de Dados Supabase 🪨</h1>

        <!-- Seção de Verificação (sempre visível) -->
        <div class="section">
            <div class="section-header">
                <h2>🔍 Verificação</h2>
            </div>
            <p style="color: #666; margin-bottom: 10px;">
                Digite o código secreto e pressione Enter ou clique em "Verificar" para liberar o acesso às listas:
            </p>
            <div class="verificacao-container">
                <input type="text" id="inputVerificacao" placeholder="Digite o código aqui..." autocomplete="off">
                <button class="btn" onclick="verificarCodigo()" id="btnVerificar">Verificar</button>
            </div>
            <div id="mensagemResultado" class="mensagem-resultado"></div>
        </div>

        <!-- Seção de Árvores (inicialmente oculta) -->
        <div id="secaoArvores" class="section hidden">
            <div class="section-header">
                <h2>🌳 Árvores</h2>
                <button class="btn" onclick="buscarArvores()" id="btnArvores">
                    Carregar Árvores
                </button>
            </div>
            <div id="arvoresStats" class="stats" style="display: none;"></div>
            <div id="arvoresLoading" class="loading" style="display: none;">
                Carregando árvores...
            </div>
            <div id="arvoresError" class="error" style="display: none;"></div>
            <div id="arvoresContainer" class="cards-container"></div>
            <div id="arvoresEmpty" class="empty-state">
                Nenhuma árvore encontrada. Clique em "Carregar Árvores" para começar.
            </div>
        </div>

        <!-- Seção de Metais (inicialmente oculta) -->
        <div id="secaoMetais" class="section hidden">
            <div class="section-header">
                <h2>🪨 Metais</h2>
                <button class="btn" onclick="buscarMetais()" id="btnMetais">
                    Carregar Metais
                </button>
            </div>
            <div id="metaisStats" class="stats" style="display: none;"></div>
            <div id="metaisLoading" class="loading" style="display: none;">
                Carregando metais...
            </div>
            <div id="metaisError" class="error" style="display: none;"></div>
            <div id="metaisContainer" class="cards-container"></div>
            <div id="metaisEmpty" class="empty-state">
                Nenhum metal encontrado. Clique em "Carregar Metais" para começar.
            </div>
        </div>
    </div>

    <script>
        // Configuração do Supabase
        const SUPABASE_URL = 'MYLINK';
        const SUPABASE_ANON_KEY = 'SUA_ANON_KEY_AQUI';

        // Variável para rastrear se o acesso já foi liberado
        let acessoLiberado = false;

        // --- LÓGICA DA CAIXA DE VERIFICAÇÃO ---
        async function verificarCodigo() {
            const input = document.getElementById('inputVerificacao');
            const texto = input.value;
            const mensagem = document.getElementById('mensagemResultado');
            const btn = document.getElementById('btnVerificar');

            if (!texto) {
                mensagem.textContent = '⚠️ Por favor, digite algo!';
                mensagem.classList.remove('mensagem-sucesso', 'mensagem-erro');
                mensagem.classList.add('mensagem-erro');
                mensagem.style.display = 'block';
                return;
            }

            btn.disabled = true;
            btn.textContent = 'Verificando...';

            try {
                const response = await fetch(
                    `${SUPABASE_URL}/rest/v1/rpc/verificar_senha`,
                    {
                        method: 'POST',
                        headers: {
                            'apikey': SUPABASE_ANON_KEY,
                            'Authorization': `Bearer ${SUPABASE_ANON_KEY}`,
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({ texto_inserido: texto })
                    }
                );

                if (!response.ok) {
                    const errorText = await response.text();
                    console.error('Erro do servidor:', response.status, errorText);
                    throw new Error(`Erro ${response.status}: ${errorText}`);
                }

                const resultado = await response.json();

                mensagem.classList.remove('mensagem-sucesso', 'mensagem-erro');

                if (resultado === true) {
                    mensagem.textContent = '✅ Tudo certo — acesso liberado!';
                    mensagem.classList.add('mensagem-sucesso');
                    
                    // Libera as seções de Árvores e Metais
                    if (!acessoLiberado) {
                        revelarSecoes();
                        acessoLiberado = true;
                    }
                } else {
                    mensagem.textContent = '❌ Deu Errado';
                    mensagem.classList.add('mensagem-erro');
                }

                mensagem.style.display = 'block';
            } catch (err) {
                mensagem.textContent = '❌ Erro ao verificar no servidor!';
                mensagem.classList.remove('mensagem-sucesso');
                mensagem.classList.add('mensagem-erro');
                mensagem.style.display = 'block';
                console.error('Erro completo:', err);
            } finally {
                btn.disabled = false;
                btn.textContent = 'Verificar';
            }
        }

        // Função para revelar as seções de Árvores e Metais com animação
        function revelarSecoes() {
            const secaoArvores = document.getElementById('secaoArvores');
            const secaoMetais = document.getElementById('secaoMetais');

            // Remove a classe hidden e adiciona animação
            secaoArvores.classList.remove('hidden');
            secaoArvores.classList.add('section-revealed');

            secaoMetais.classList.remove('hidden');
            secaoMetais.classList.add('section-revealed');

            // Faz scroll suave até a seção de Árvores
            setTimeout(() => {
                secaoArvores.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }, 100);
        }

        // Permite verificar pressionando Enter
        document.getElementById('inputVerificacao').addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                verificarCodigo();
            }
        });

        // --- LÓGICA DO SUPABASE (ÁRVORES E METAIS) ---
        async function buscarDados(tabela) {
            try {
                const response = await fetch(`${SUPABASE_URL}/rest/v1/${tabela}?select=*`, {
                    method: 'GET',
                    headers: {
                        'apikey': SUPABASE_ANON_KEY,
                        'Authorization': `Bearer ${SUPABASE_ANON_KEY}`,
                        'Content-Type': 'application/json'
                    }
                });

                if (!response.ok) {
                    throw new Error(`Erro na requisição: ${response.status}`);
                }

                const data = await response.json();
                return data;
            } catch (error) {
                console.error(`Erro ao buscar ${tabela}:`, error);
                throw error;
            }
        }

        async function buscarArvores() {
            const loading = document.getElementById('arvoresLoading');
            const error = document.getElementById('arvoresError');
            const container = document.getElementById('arvoresContainer');
            const empty = document.getElementById('arvoresEmpty');
            const stats = document.getElementById('arvoresStats');
            const btn = document.getElementById('btnArvores');

            error.style.display = 'none';
            container.innerHTML = '';
            empty.style.display = 'none';
            stats.style.display = 'none';
            loading.style.display = 'block';
            btn.disabled = true;

            try {
                const arvores = await buscarDados('arvores');
                loading.style.display = 'none';

                if (arvores.length === 0) {
                    empty.style.display = 'block';
                } else {
                    stats.innerHTML = `
                        <div class="stat-box">
                            <span class="stat-number">${arvores.length}</span>
                            <span class="stat-label">Árvores Encontradas</span>
                        </div>
                    `;
                    stats.style.display = 'flex';

                    arvores.forEach(arvore => {
                        const card = document.createElement('div');
                        card.className = 'card';
                        card.innerHTML = `
                            <h3>${arvore.nome}</h3>
                            <p><span class="label">Tipo:</span> ${arvore.tipo || 'Não informado'}</p>
                            <p><span class="label">Descrição:</span> ${arvore.descricao || 'Sem descrição'}</p>
                            <p><span class="label">ID:</span> <code>${arvore.id}</code></p>
                            <p><span class="label">Criado em:</span> ${new Date(arvore.created_at).toLocaleString('pt-BR')}</p>
                        `;
                        container.appendChild(card);
                    });
                }
            } catch (err) {
                loading.style.display = 'none';
                error.textContent = `❌ Erro ao carregar árvores: ${err.message}`;
                error.style.display = 'block';
            } finally {
                btn.disabled = false;
            }
        }

        async function buscarMetais() {
            const loading = document.getElementById('metaisLoading');
            const error = document.getElementById('metaisError');
            const container = document.getElementById('metaisContainer');
            const empty = document.getElementById('metaisEmpty');
            const stats = document.getElementById('metaisStats');
            const btn = document.getElementById('btnMetais');

            error.style.display = 'none';
            container.innerHTML = '';
            empty.style.display = 'none';
            stats.style.display = 'none';
            loading.style.display = 'block';
            btn.disabled = true;

            try {
                const metais = await buscarDados('metais');
                loading.style.display = 'none';

                if (metais.length === 0) {
                    empty.style.display = 'block';
                } else {
                    stats.innerHTML = `
                        <div class="stat-box">
                            <span class="stat-number">${metais.length}</span>
                            <span class="stat-label">Metais Encontrados</span>
                        </div>
                    `;
                    stats.style.display = 'flex';

                    metais.forEach(metal => {
                        const card = document.createElement('div');
                        card.className = 'card';
                        card.innerHTML = `
                            <h3>${metal.nome}</h3>
                            <p><span class="label">Símbolo Químico:</span> <span class="badge">${metal.simbolo_quimico || 'N/A'}</span></p>
                            <p><span class="label">Descrição:</span> ${metal.descricao || 'Sem descrição'}</p>
                            <p><span class="label">ID:</span> <code>${metal.id}</code></p>
                            <p><span class="label">Criado em:</span> ${new Date(metal.created_at).toLocaleString('pt-BR')}</p>
                        `;
                        container.appendChild(card);
                    });
                }
            } catch (err) {
                loading.style.display = 'none';
                error.textContent = `❌ Erro ao carregar metais: ${err.message}`;
                error.style.display = 'block';
            } finally {
                btn.disabled = false;
            }
        }
    </script>
</body>
</html>
