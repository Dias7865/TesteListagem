<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Leitor de Dados Seguro - Árvores e Metais</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
        }

        /* Tela de Login */
        .login-screen {
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 80vh;
        }

        .login-box {
            background: white;
            padding: 40px;
            border-radius: 16px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
            text-align: center;
            max-width: 400px;
            width: 100%;
        }

        .login-box h2 {
            color: #333;
            margin-bottom: 10px;
            font-size: 2rem;
        }

        .login-box p {
            color: #666;
            margin-bottom: 30px;
        }

        .login-box input {
            width: 100%;
            padding: 15px;
            border: 2px solid #e0e0e0;
            border-radius: 8px;
            font-size: 16px;
            margin-bottom: 20px;
            transition: border-color 0.3s;
        }

        .login-box input:focus {
            outline: none;
            border-color: #667eea;
        }

        .login-box button {
            width: 100%;
            padding: 15px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            transition: transform 0.2s;
        }

        .login-box button:hover {
            transform: translateY(-2px);
        }

        .login-box button:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }

        .login-error {
            color: #c33;
            margin-top: 15px;
            font-weight: bold;
            display: none;
        }

        /* Conteúdo Principal */
        .main-content {
            display: none;
        }

        h1 {
            text-align: center;
            color: white;
            margin-bottom: 30px;
            font-size: 2.5rem;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
        }

        .section {
            background: white;
            border-radius: 12px;
            padding: 30px;
            margin-bottom: 30px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
        }

        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            border-bottom: 2px solid #f0f0f0;
            padding-bottom: 15px;
        }

        h2 {
            color: #333;
            font-size: 1.8rem;
        }

        .btn {
            padding: 12px 24px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-size: 16px;
            font-weight: bold;
            transition: transform 0.2s, box-shadow 0.2s;
        }

        .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4);
        }

        .btn:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }

        .loading {
            text-align: center;
            padding: 20px;
            color: #667eea;
            font-size: 1.1rem;
        }

        .error {
            background: #fee;
            border: 1px solid #fcc;
            color: #c33;
            padding: 15px;
            border-radius: 8px;
            margin-top: 15px;
        }

        .cards-container {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 20px;
            margin-top: 20px;
        }

        .card {
            background: #f9f9f9;
            border-radius: 10px;
            padding: 20px;
            border-left: 4px solid #667eea;
            transition: transform 0.2s, box-shadow 0.2s;
        }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 5px 20px rgba(0,0,0,0.1);
        }

        .card h3 {
            color: #333;
            margin-bottom: 10px;
            font-size: 1.4rem;
        }

        .card p {
            color: #666;
            margin: 8px 0;
            line-height: 1.6;
        }

        .card .label {
            font-weight: bold;
            color: #764ba2;
        }

        .badge {
            display: inline-block;
            background: #667eea;
            color: white;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.85rem;
            margin-top: 8px;
        }

        .empty-state {
            text-align: center;
            padding: 40px;
            color: #999;
        }

        .stats {
            display: flex;
            gap: 20px;
            margin-top: 15px;
            flex-wrap: wrap;
        }

        .stat-box {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 15px 25px;
            border-radius: 8px;
            text-align: center;
        }

        .stat-number {
            font-size: 2rem;
            font-weight: bold;
            display: block;
        }

        .stat-label {
            font-size: 0.9rem;
            opacity: 0.9;
        }

        .hidden {
            display: none !important;
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Tela de Login com Palavra-Chave -->
        <div id="loginScreen" class="login-screen">
            <div class="login-box">
                <h2>🔐 Acesso Restrito</h2>
                <p>Digite a palavra-chave para acessar os dados</p>
                <input type="password" id="palavraChave" placeholder="Digite a palavra-chave..." autocomplete="off">
                <button onclick="verificarAcesso()" id="btnLogin">Acessar</button>
                <div id="loginError" class="login-error">❌ Palavra-chave incorreta!</div>
            </div>
        </div>

        <!-- Conteúdo Principal (inicialmente oculto) -->
        <div id="mainContent" class="main-content">
            <h1>🌳 Leitor de Dados Supabase 🪨</h1>

            <!-- Seção de Árvores -->
            <div class="section">
                <div class="section-header">
                    <h2>🌳 Árvores</h2>
                    <button class="btn" onclick="buscarArvores()" id="btnArvores">
                        Carregar Árvores
                    </button>
                </div>
                <div id="arvoresStats" class="stats" style="display: none;"></div>
                <div id="arvoresLoading" class="loading" style="display: none;">
                    Carregando árvores...
                </div>
                <div id="arvoresError" class="error" style="display: none;"></div>
                <div id="arvoresContainer" class="cards-container"></div>
                <div id="arvoresEmpty" class="empty-state" style="display: none;">
                    Nenhuma árvore encontrada. Clique em "Carregar Árvores" para começar.
                </div>
            </div>

            <!-- Seção de Metais -->
            <div class="section">
                <div class="section-header">
                    <h2>🪨 Metais</h2>
                    <button class="btn" onclick="buscarMetais()" id="btnMetais">
                        Carregar Metais
                    </button>
                </div>
                <div id="metaisStats" class="stats" style="display: none;"></div>
                <div id="metaisLoading" class="loading" style="display: none;">
                    Carregando metais...
                </div>
                <div id="metaisError" class="error" style="display: none;"></div>
                <div id="metaisContainer" class="cards-container"></div>
                <div id="metaisEmpty" class="empty-state" style="display: none;">
                    Nenhum metal encontrado. Clique em "Carregar Metais" para começar.
                </div>
            </div>
        </div>
    </div>

    <script>
        // Configuração do Supabase
        const SUPABASE_URL = 'MYLINK';
        const SUPABASE_ANON_KEY = 'SUA_ANON_KEY_AQUI';

        // Variável global para armazenar a palavra-chave validada
        let palavraChaveValidada = null;

        // Função para verificar a palavra-chave
        async function verificarAcesso() {
            const input = document.getElementById('palavraChave');
            const palavraDigitada = input.value.trim();
            const erro = document.getElementById('loginError');
            const btn = document.getElementById('btnLogin');

            if (!palavraDigitada) {
                erro.textContent = '⚠️ Por favor, digite a palavra-chave!';
                erro.style.display = 'block';
                return;
            }

            btn.disabled = true;
            btn.textContent = 'Verificando...';
            erro.style.display = 'none';

            try {
                // Tenta buscar árvores com a palavra-chave fornecida
                const response = await fetch(
                    `${SUPABASE_URL}/rest/v1/rpc/buscar_arvores_seguro?palavra_chave=${encodeURIComponent(palavraDigitada)}`,
                    {
                        method: 'GET',
                        headers: {
                            'apikey': SUPABASE_ANON_KEY,
                            'Authorization': `Bearer ${SUPABASE_ANON_KEY}`,
                            'Content-Type': 'application/json'
                        }
                    }
                );

                if (!response.ok) {
                    throw new Error('Erro na requisição');
                }

                const data = await response.json();

                // Se retornou dados, a palavra-chave está correta
                if (data.length > 0) {
                    palavraChaveValidada = palavraDigitada;
                    document.getElementById('loginScreen').style.display = 'none';
                    document.getElementById('mainContent').style.display = 'block';
                    
                    // Mostrar estados vazios iniciais
                    document.getElementById('arvoresEmpty').style.display = 'block';
                    document.getElementById('metaisEmpty').style.display = 'block';
                } else {
                    // Palavra-chave incorreta (retornou vazio)
                    erro.textContent = '❌ Palavra-chave incorreta!';
                    erro.style.display = 'block';
                    input.value = '';
                    input.focus();
                }
            } catch (err) {
                erro.textContent = '❌ Erro ao verificar palavra-chave!';
                erro.style.display = 'block';
                console.error('Erro:', err);
            } finally {
                btn.disabled = false;
                btn.textContent = 'Acessar';
            }
        }

        // Permitir pressionar Enter na tela de login
        document.getElementById('palavraChave').addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                verificarAcesso();
            }
        });

        // Função genérica para fazer requisições ao Supabase usando as funções seguras
        async function buscarDadosSeguro(nomeFuncao) {
            try {
                const response = await fetch(
                    `${SUPABASE_URL}/rest/v1/rpc/${nomeFuncao}?palavra_chave=${encodeURIComponent(palavraChaveValidada)}`,
                    {
                        method: 'GET',
                        headers: {
                            'apikey': SUPABASE_ANON_KEY,
                            'Authorization': `Bearer ${SUPABASE_ANON_KEY}`,
                            'Content-Type': 'application/json'
                        }
                    }
                );

                if (!response.ok) {
                    throw new Error(`Erro na requisição: ${response.status}`);
                }

                const data = await response.json();
                return data;
            } catch (error) {
                console.error(`Erro ao buscar dados:`, error);
                throw error;
            }
        }

        // Função para buscar e exibir árvores
        async function buscarArvores() {
            const loading = document.getElementById('arvoresLoading');
            const error = document.getElementById('arvoresError');
            const container = document.getElementById('arvoresContainer');
            const empty = document.getElementById('arvoresEmpty');
            const stats = document.getElementById('arvoresStats');
            const btn = document.getElementById('btnArvores');

            error.style.display = 'none';
            container.innerHTML = '';
            empty.style.display = 'none';
            stats.style.display = 'none';
            loading.style.display = 'block';
            btn.disabled = true;

            try {
                const arvores = await buscarDadosSeguro('buscar_arvores_seguro');
                loading.style.display = 'none';

                if (arvores.length === 0) {
                    empty.style.display = 'block';
                } else {
                    stats.innerHTML = `
                        <div class="stat-box">
                            <span class="stat-number">${arvores.length}</span>
                            <span class="stat-label">Árvores Encontradas</span>
                        </div>
                    `;
                    stats.style.display = 'flex';

                    arvores.forEach(arvore => {
                        const card = document.createElement('div');
                        card.className = 'card';
                        card.innerHTML = `
                            <h3>${arvore.nome}</h3>
                            <p><span class="label">Tipo:</span> ${arvore.tipo || 'Não informado'}</p>
                            <p><span class="label">Descrição:</span> ${arvore.descricao || 'Sem descrição'}</p>
                            <p><span class="label">ID:</span> <code>${arvore.id}</code></p>
                            <p><span class="label">Criado em:</span> ${new Date(arvore.created_at).toLocaleString('pt-BR')}</p>
                        `;
                        container.appendChild(card);
                    });
                }
            } catch (err) {
                loading.style.display = 'none';
                error.textContent = `❌ Erro ao carregar árvores: ${err.message}`;
                error.style.display = 'block';
            } finally {
                btn.disabled = false;
            }
        }

        // Função para buscar e exibir metais
        async function buscarMetais() {
            const loading = document.getElementById('metaisLoading');
            const error = document.getElementById('metaisError');
            const container = document.getElementById('metaisContainer');
            const empty = document.getElementById('metaisEmpty');
            const stats = document.getElementById('metaisStats');
            const btn = document.getElementById('btnMetais');

            error.style.display = 'none';
            container.innerHTML = '';
            empty.style.display = 'none';
            stats.style.display = 'none';
            loading.style.display = 'block';
            btn.disabled = true;

            try {
                const metais = await buscarDadosSeguro('buscar_metais_seguro');
                loading.style.display = 'none';

                if (metais.length === 0) {
                    empty.style.display = 'block';
                } else {
                    stats.innerHTML = `
                        <div class="stat-box">
                            <span class="stat-number">${metais.length}</span>
                            <span class="stat-label">Metais Encontrados</span>
                        </div>
                    `;
                    stats.style.display = 'flex';

                    metais.forEach(metal => {
                        const card = document.createElement('div');
                        card.className = 'card';
                        card.innerHTML = `
                            <h3>${metal.nome}</h3>
                            <p><span class="label">Símbolo Químico:</span> <span class="badge">${metal.simbolo_quimico || 'N/A'}</span></p>
                            <p><span class="label">Descrição:</span> ${metal.descricao || 'Sem descrição'}</p>
                            <p><span class="label">ID:</span> <code>${metal.id}</code></p>
                            <p><span class="label">Criado em:</span> ${new Date(metal.created_at).toLocaleString('pt-BR')}</p>
                        `;
                        container.appendChild(card);
                    });
                }
            } catch (err) {
                loading.style.display = 'none';
                error.textContent = `❌ Erro ao carregar metais: ${err.message}`;
                error.style.display = 'block';
            } finally {
                btn.disabled = false;
            }
        }
    </script>
</body>
</html>
