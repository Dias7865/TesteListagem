async function salvarEdicaoTarefa(index) {
    const tarefa = dadosTarefas[index];
    const nome = document.getElementById('editNomeTarefa').value.trim();
    if (!nome) return;

    let statusVal = document.getElementById('editStatusTarefa').value || null;
    let dataVal = document.getElementById('editDataEsperadaTarefa').value || null;

    if (statusVal && statusVal.toLowerCase().includes('conclu')) {
        dataVal = obterDataHojeLocal();
    }

    const matTexto = document.getElementById('editMateriaisFaltandoTarefa').value.trim();
    const materiaisArray = matTexto ? matTexto.split('\n').map(i => i.trim()).filter(Boolean) : [];

    try {
        const response = await fetch(`${SUPABASE_URL}/rest/v1/tarefas?id=eq.${tarefa.id}`, {
            method: 'PATCH',
            headers: { 'apikey': SUPABASE_ANON_KEY, 'Authorization': `Bearer ${SUPABASE_ANON_KEY}`, 'Content-Type': 'application/json', 'Prefer': 'return=representation' },
            body: JSON.stringify({
                nome: nome,
                tipo: document.getElementById('editTipoTarefa').value.trim() || null,
                status: statusVal,
                endereco: document.getElementById('editEnderecoTarefa').value.trim() || null,
                data_inicio_obra: document.getElementById('editDataInicioObraTarefa').value || null,
                data_para_termino: dataVal,
                intg_id: document.getElementById('editIntegradorTarefa').value || null, 
                status_material: document.getElementById('editStatusMaterialTarefa').value || null,
                materiais_faltando: materiaisArray.length > 0 ? materiaisArray : null,
                pendencias: document.getElementById('editPendenciasTarefa').value.trim() || null,
                relatorio_atividades: document.getElementById('editRelatorioAtividadesTarefa').value.trim() || null,
                descricao: document.getElementById('editDescricaoTarefa').value.trim() || null
            })
        });

        if (!response.ok) throw new Error('Erro ao atualizar');
        const atualizada = await response.json();
        dadosTarefas[index] = atualizada[0];
        mostrarDetalhesTarefa();
        fecharModalEditTarefa();
        await carregarTarefas();
        await carregarPagina1();
    } catch (err) { alert(`❌ Erro: ${err.message}`); }
}

// --- ADICIONAR TAREFAS / INTEGRADORES ---
function atualizarFormulario() {
    const tipo = document.getElementById('tipoElemento').value;
    document.getElementById('formTarefa').classList.add('hidden');
    document.getElementById('formIntegrador').classList.add('hidden');
    if (tipo === 'tarefa') document.getElementById('formTarefa').classList.remove('hidden');
    else if (tipo === 'integrador') document.getElementById('formIntegrador').classList.remove('hidden');
}

async function adicionarTarefa() {
    const nome = document.getElementById('nomeTarefa').value.trim();
    if (!nome) return alert('⚠️ Digite o nome da tarefa');

    // Transforma a lista de materiais (separados por quebra de linha) em um Array
    const matTexto = document.getElementById('materiaisFaltandoTarefa').value.trim();
    const materiaisArray = matTexto ? matTexto.split('\n').map(i => i.trim()).filter(Boolean) : [];

    try {
        const response = await fetch(`${SUPABASE_URL}/rest/v1/tarefas`, {
            method: 'POST',
            headers: { 'apikey': SUPABASE_ANON_KEY, 'Authorization': `Bearer ${SUPABASE_ANON_KEY}`, 'Content-Type': 'application/json', 'Prefer': 'return=representation' },
            body: JSON.stringify({
                nome: nome,
                tipo: document.getElementById('tipoTarefa').value.trim() || null,
                status: document.getElementById('statusTarefa').value || null,
                endereco: document.getElementById('enderecoTarefa').value.trim() || null,
                data_inicio_obra: document.getElementById('dataInicioObraTarefa').value || null,
                data_para_termino: document.getElementById('dataEsperadaTarefa').value || null,
                intg_id: document.getElementById('integradorTarefa').value || null,
                status_material: document.getElementById('statusMaterialTarefa').value || null,
                materiais_faltando: materiaisArray.length > 0 ? materiaisArray : null,
                pendencias: document.getElementById('pendenciasTarefa').value.trim() || null,
                relatorio_atividades: document.getElementById('relatorioAtividadesTarefa').value.trim() || null,
                descricao: document.getElementById('descricaoTarefa').value.trim() || null
            })
        });
        if (!response.ok) throw new Error('Erro ao adicionar');
        await carregarTarefas();
        alert('✅ Tarefa adicionada!');
        resetarFormularioAdicao();
    } catch (err) { alert(`❌ Erro: ${err.message}`); }
}

