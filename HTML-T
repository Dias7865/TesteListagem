    `;
}

function cancelarEdicaoIntegrador() {
    document.getElementById('editFormIntegrador').innerHTML = '';
}

async function salvarEdicaoIntegrador(index) {
    const integrador = dadosIntegradores[index];
    const nome = document.getElementById('editNomeIntegrador').value.trim();
    const ncpf = document.getElementById('editNCPFIntegrador').value.trim();

    if (!nome) {
        document.getElementById('editMsgIntegrador').innerHTML = '<div class="error">⚠️ O nome é obrigatório!</div>';
        return;
    }

    try {
        const response = await fetch(`${SUPABASE_URL}/rest/v1/integradores?id=eq.${integrador.id}`, {
            method: 'PATCH',
            headers: {
                'apikey': SUPABASE_ANON_KEY,
                'Authorization': `Bearer ${SUPABASE_ANON_KEY}`,
                'Content-Type': 'application/json',
                'Prefer': 'return=representation'
            },
            body: JSON.stringify({ nome: nome, integrador_cpf: ncpf || null })
        });

        if (!response.ok) throw new Error('Erro ao atualizar');
        const atualizado = await response.json();
        dadosIntegradores[index] = atualizado[0];
        document.getElementById('selectIntegradores').options[document.getElementById('selectIntegradores').selectedIndex].textContent = nome;
        mostrarDetalhesIntegrador();

        // ✅ SINCRONIZA AS TABELAS NO BANCO
        await sincronizarIntegradoresComIntensidades();

    } catch (err) {
        document.getElementById('editMsgIntegrador').innerHTML = `<div class="error">❌ Erro: ${err.message}</div>`;
    }
}

// --- REMOÇÃO ---
async function removerTarefa(index) {
    const t = dadosTarefas[index];
    if (!confirm(`Remover "${t.nome}"?`)) return;
    try {
        await fetch(`${SUPABASE_URL}/rest/v1/tarefas?id=eq.${t.id}`, {
            method: 'DELETE',
            headers: { 'apikey': SUPABASE_ANON_KEY, 'Authorization': `Bearer ${SUPABASE_ANON_KEY}` }
        });
        dadosTarefas.splice(index, 1);
        const select = document.getElementById('selectTarefas');
        select.innerHTML = '<option value="">-- Escolha uma tarefa --</option>';
        dadosTarefas.forEach((ta, i) => {
            const opt = document.createElement('option');
            opt.value = i; opt.textContent = ta.nome;
            select.appendChild(opt);
        });
        document.getElementById('detalhesTarefa').style.display = 'none';
        alert(`✅ Removida!`);
    } catch (err) { alert(`❌ Erro: ${err.message}`); }
}

async function removerIntegrador(index) {
    const i = dadosIntegradores[index];
    if (!confirm(`Remover "${i.nome}"?`)) return;
    try {
        await fetch(`${SUPABASE_URL}/rest/v1/integradores?id=eq.${i.id}`, {
            method: 'DELETE',
            headers: { 'apikey': SUPABASE_ANON_KEY, 'Authorization': `Bearer ${SUPABASE_ANON_KEY}` }
        });
        dadosIntegradores.splice(index, 1);
        const select = document.getElementById('selectIntegradores');
        select.innerHTML = '<option value="">-- Escolha um integrador --</option>';
        dadosIntegradores.forEach((it, j) => {
            const opt = document.createElement('option');
            opt.value = j; opt.textContent = it.nome;
            select.appendChild(opt);
        });
        popularSelectIntegrador('integradorTarefa'); // Atualiza os selects em outros lugares
        document.getElementById('detalhesIntegrador').style.display = 'none';
        
        // ✅ Sincroniza intensidades após remoção
        await sincronizarIntegradoresComIntensidades();
        
        alert(`✅ Removido!`);
    } catch (err) { alert(`❌ Erro: ${err.message}`); }
}

// --- ADICIONAR ---
function atualizarFormulario() {
    const tipo = document.getElementById('tipoElemento').value;
    document.getElementById('formTarefa').classList.add('hidden');
    document.getElementById('formIntegrador').classList.add('hidden');
    document.getElementById('mensagemAdicionar').innerHTML = '';
    if (tipo === 'tarefa') document.getElementById('formTarefa').classList.remove('hidden');
    else if (tipo === 'integrador') document.getElementById('formIntegrador').classList.remove('hidden');
}

async function adicionarTarefa() {
    const nome = document.getElementById('nomeTarefa').value.trim();
    const integradorId = document.getElementById('integradorTarefa').value;
    const msg = document.getElementById('mensagemAdicionar');
    const btn = document.getElementById('btnAdicionarTarefa');
    if (!nome) { msg.innerHTML = '<div class="error">⚠️ Nome obrigatório!</div>'; return; }

    btn.disabled = true; btn.textContent = 'Adicionando...';
    try {
        const response = await fetch(`${SUPABASE_URL}/rest/v1/tarefas`, {
            method: 'POST',
            headers: {
                'apikey': SUPABASE_ANON_KEY,
                'Authorization': `Bearer ${SUPABASE_ANON_KEY}`,
                'Content-Type': 'application/json',
                'Prefer': 'return=representation'
            },
            body: JSON.stringify({
                nome: nome,
                tipo: document.getElementById('tipoTarefa').value.trim() || null,
                status: document.getElementById('statusTarefa').value || null,
                data_para_termino: document.getElementById('dataEsperadaTarefa').value || null,
                intg_id: integradorId || null, 
                descricao: document.getElementById('descricaoTarefa').value.trim() || null
            })
        });
        if (!response.ok) throw new Error('Erro ao adicionar');
        const nova = await response.json();
        dadosTarefas.push(nova[0]);
        const select = document.getElementById('selectTarefas');
        const opt = document.createElement('option');
        opt.value = dadosTarefas.length - 1;
        opt.textContent = nova[0].nome;
        select.appendChild(opt);

        document.getElementById('tipoElemento').value = '';
        document.getElementById('formTarefa').classList.add('hidden');
        ['nomeTarefa','tipoTarefa','statusTarefa','dataEsperadaTarefa','integradorTarefa','descricaoTarefa'].forEach(id => document.getElementById(id).value = '');
        msg.innerHTML = `<div class="success">✅ Tarefa "${nova[0].nome}" adicionada!</div>`;
    } catch (err) {
        msg.innerHTML = `<div class="error">❌ Erro: ${err.message}</div>`;
    } finally {
        btn.disabled = false; btn.textContent = 'Adicionar Tarefa';
    }
}

async function adicionarIntegrador() {
    const nome = document.getElementById('nomeIntegrador').value.trim();
    const msg = document.getElementById('mensagemAdicionar');
    const btn = document.getElementById('btnAdicionarIntegrador');
    if (!nome) { msg.innerHTML = '<div class="error">⚠️ Nome obrigatório!</div>'; return; }

    btn.disabled = true; btn.textContent = 'Adicionando...';
    try {
        const response = await fetch(`${SUPABASE_URL}/rest/v1/integradores`, {
            method: 'POST',
            headers: {
                'apikey': SUPABASE_ANON_KEY,
                'Authorization': `Bearer ${SUPABASE_ANON_KEY}`,
                'Content-Type': 'application/json',
                'Prefer': 'return=representation'
            },
            body: JSON.stringify({
                nome: nome,
                integrador_cpf: document.getElementById('ncpfIntegrador').value.trim() || null
            })
        });
        if (!response.ok) throw new Error('Erro ao adicionar');
        const novo = await response.json();
        dadosIntegradores.push(novo[0]);
        
        // Atualiza os selects
        const select = document.getElementById('selectIntegradores');
        const opt = document.createElement('option');
        opt.value = dadosIntegradores.length - 1;
        opt.textContent = novo[0].nome;
        select.appendChild(opt);
        popularSelectIntegrador('integradorTarefa'); 

        document.getElementById('tipoElemento').value = '';
        document.getElementById('formIntegrador').classList.add('hidden');
        ['nomeIntegrador','ncpfIntegrador'].forEach(id => document.getElementById(id).value = '');
        msg.innerHTML = `<div class="success">✅ Integrador "${novo[0].nome}" adicionado!</div>`;
        
        // ✅ SINCRONIZA AS TABELAS NO BANCO
        await sincronizarIntegradoresComIntensidades();

    } catch (err) {
        msg.innerHTML = `<div class="error">❌ Erro: ${err.message}</div>`;
    } finally {
        btn.disabled = false; btn.textContent = 'Adicionar Integrador';
    }
}

// --- FUNÇÃO PARA COPIAR DADOS ---
async function sincronizarIntegradoresComIntensidades() {
    try {
        const response = await fetch(`${SUPABASE_URL}/rest/v1/rpc/copiar_integradores_para_intensidades`, {
            method: 'POST',
            headers: {
                'apikey': SUPABASE_ANON_KEY,
                'Authorization': `Bearer ${SUPABASE_ANON_KEY}`,
                'Content-Type': 'application/json'
            }
        });

        if (!response.ok) throw new Error('Erro ao sincronizar tabelas no Supabase');
        console.log('✅ Dados copiados de integradores para intensidades com sucesso!');
    } catch (err) {
        console.error('❌ Erro na sincronização:', err);
    }
}

// --- DASHBOARD ---
function abrirDashboard() {
    if (dadosTarefas.length === 0) { alert('⚠️ Sem tarefas!'); return; }
    const track = document.getElementById('dashboardTrack');
    const cardsHTML = dadosTarefas.map(t => `
        <div class="dashboard-card">
            <h3>${t.nome}</h3>
            <p><span class="label">Status:</span> ${getStatusBadge(t.status)}</p>
            <p><span class="label">Integrador:</span> ${getIntegradorBadge(t.intg_id)}</p>
            <p><span class="label">Data Esperada:</span> ${formatarData(t.data_para_termino)}</p>
            <p><span class="label">Descrição:</span> ${t.descricao || 'Sem descrição'}</p>
            <p><span class="label">Criado em:</span> ${new Date(t.created_at).toLocaleString('pt-BR')}</p>
        </div>
    `).join('');
    track.innerHTML = cardsHTML + cardsHTML;
    track.style.setProperty('--card-count', dadosTarefas.length);
    document.getElementById('dashboardOverlay').classList.add('active');
}

function fecharDashboard() {
    document.getElementById('dashboardOverlay').classList.remove('active');
}
