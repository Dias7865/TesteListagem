function obterBadgePrazo(dataISO) {
    if (!dataISO) return '';
    const [ano, mes, dia] = dataISO.split('T')[0].split('-');
    const dataTermino = new Date(ano, mes - 1, dia);
    const hoje = new Date(); hoje.setHours(0, 0, 0, 0);
    const diffDias = Math.round((dataTermino.getTime() - hoje.getTime()) / (1000 * 60 * 60 * 24));

    if (diffDias > 8) return '<span class="status-badge prazo-no-prazo">🟢 No prazo</span>';
    if (diffDias > 1) return '<span class="status-badge prazo-proximo">⚠️ PRAZO PRÓXIMO</span>';
    if (diffDias >= 0) return '<span class="status-badge prazo-limite">🚨 DIA LIMITE</span>';
    return '<span class="status-badge prazo-atrasado">❌ ATRASADO</span>';
}

