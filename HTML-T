        }

        function abrirEdicaoArvore(index) {
            const arvore = dadosArvores[index];
            const editFormDiv = document.getElementById('editFormArvore');

            const dataISO = arvore.data_para_plantio ? new Date(arvore.data_para_plantio).toISOString().split('T')[0] : '';

            editFormDiv.innerHTML = `
                <div class="edit-form">
                    <h4>✏️ Editando: ${arvore.nome}</h4>
                    <div class="form-group">
                        <label for="editNomeArvore">Nome:</label>
                        <input type="text" id="editNomeArvore" value="${arvore.nome || ''}">
                    </div>
                    <div class="form-group">
                        <label for="editTipoArvore">Tipo:</label>
                        <input type="text" id="editTipoArvore" value="${arvore.tipo || ''}">
                    </div>
                    <div class="form-group">
                        <label for="editStatusArvore">Status:</label>
                        <select id="editStatusArvore">
                            <option value="">-- Selecione o status --</option>
                            <option value="plantado" ${arvore.status === 'plantado' ? 'selected' : ''}>🌱 Plantado</option>
                            <option value="aguardando fertilizante" ${arvore.status === 'aguardando fertilizante' ? 'selected' : ''}>⏳ Aguardando Fertilizante</option>
                            <option value="não plantado" ${arvore.status === 'não plantado' ? 'selected' : ''}>❌ Não Plantado</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="editDataPlantioArvore">Data Para Plantio:</label>
                        <input type="date" id="editDataPlantioArvore" value="${dataISO}">
                    </div>
                    <div class="form-group">
                        <label for="editDescricaoArvore">Descrição:</label>
                        <textarea id="editDescricaoArvore">${arvore.descricao || ''}</textarea>
                    </div>
                    <div class="action-buttons">
                        <button class="btn btn-success" onclick="salvarEdicaoArvore(${index})">💾 Salvar</button>
                        <button class="btn btn-secondary" onclick="cancelarEdicaoArvore()">❌ Cancelar</button>
                    </div>
                    <div id="editMsgArvore" style="margin-top: 10px;"></div>
                </div>
            `;
        }

        function cancelarEdicaoArvore() {
            document.getElementById('editFormArvore').innerHTML = '';
        }

        async function salvarEdicaoArvore(index) {
            const arvore = dadosArvores[index];
            const nome = document.getElementById('editNomeArvore').value.trim();
            const tipo = document.getElementById('editTipoArvore').value.trim();
            const status = document.getElementById('editStatusArvore').value;
            const dataPlantio = document.getElementById('editDataPlantioArvore').value;
            const descricao = document.getElementById('editDescricaoArvore').value.trim();
            const msgDiv = document.getElementById('editMsgArvore');

            if (!nome) {
                msgDiv.innerHTML = '<div class="error">⚠️ O nome é obrigatório!</div>';
                return;
            }

            try {
                const response = await fetch(`${SUPABASE_URL}/rest/v1/arvores?id=eq.${arvore.id}`, {
                    method: 'PATCH',
                    headers: {
                        'apikey': SUPABASE_ANON_KEY,
                        'Authorization': `Bearer ${SUPABASE_ANON_KEY}`,
                        'Content-Type': 'application/json',
                        'Prefer': 'return=representation'
                    },
                    body: JSON.stringify({
                        nome: nome,
                        tipo: tipo || null,
                        status: status || null,
                        data_para_plantio: dataPlantio || null,
                        descricao: descricao || null
                    })
                });

                if (!response.ok) {
                    throw new Error('Erro ao atualizar');
                }

                const atualizada = await response.json();
                
                dadosArvores[index] = atualizada[0];
                
                const select = document.getElementById('selectArvores');
                select.options[select.selectedIndex].textContent = nome;
                
                mostrarDetalhesArvore();
            } catch (err) {
                msgDiv.innerHTML = `<div class="error">❌ Erro ao salvar: ${err.message}</div>`;
                console.error('Erro:', err);
            }
        }

        function abrirEdicaoMetal(index) {
            const metal = dadosMetais[index];
            const editFormDiv = document.getElementById('editFormMetal');

            editFormDiv.innerHTML = `
                <div class="edit-form">
                    <h4>✏️ Editando: ${metal.nome}</h4>
                    <div class="form-group">
                        <label for="editNomeMetal">Nome:</label>
                        <input type="text" id="editNomeMetal" value="${metal.nome || ''}">
                    </div>
                    <div class="form-group">
                        <label for="editSimboloMetal">Símbolo Químico:</label>
                        <input type="text" id="editSimboloMetal" value="${metal.simbolo_quimico || ''}" maxlength="10">
                    </div>
                    <div class="form-group">
                        <label for="editDescricaoMetal">Descrição:</label>
                        <textarea id="editDescricaoMetal">${metal.descricao || ''}</textarea>
                    </div>
                    <div class="action-buttons">
                        <button class="btn btn-success" onclick="salvarEdicaoMetal(${index})">💾 Salvar</button>
                        <button class="btn btn-secondary" onclick="cancelarEdicaoMetal()">❌ Cancelar</button>
                    </div>
                    <div id="editMsgMetal" style="margin-top: 10px;"></div>
                </div>
            `;
        }

        function cancelarEdicaoMetal() {
            document.getElementById('editFormMetal').innerHTML = '';
        }

        async function salvarEdicaoMetal(index) {
            const metal = dadosMetais[index];
            const nome = document.getElementById('editNomeMetal').value.trim();
            const simbolo = document.getElementById('editSimboloMetal').value.trim();
            const descricao = document.getElementById('editDescricaoMetal').value.trim();
            const msgDiv = document.getElementById('editMsgMetal');

            if (!nome) {
                msgDiv.innerHTML = '<div class="error">⚠️ O nome é obrigatório!</div>';
                return;
            }

            try {
                const response = await fetch(`${SUPABASE_URL}/rest/v1/metais?id=eq.${metal.id}`, {
                    method: 'PATCH',
                    headers: {
                        'apikey': SUPABASE_ANON_KEY,
                        'Authorization': `Bearer ${SUPABASE_ANON_KEY}`,
                        'Content-Type': 'application/json',
                        'Prefer': 'return=representation'
                    },
                    body: JSON.stringify({
                        nome: nome,
                        simbolo_quimico: simbolo || null,
                        descricao: descricao || null
                    })
                });

                if (!response.ok) {
                    throw new Error('Erro ao atualizar');
                }

                const atualizado = await response.json();
                
                dadosMetais[index] = atualizado[0];
                
                const select = document.getElementById('selectMetais');
                select.options[select.selectedIndex].textContent = nome;
                
                mostrarDetalhesMetal();
            } catch (err) {
                msgDiv.innerHTML = `<div class="error">❌ Erro ao salvar: ${err.message}</div>`;
                console.error('Erro:', err);
            }
        }

        async function removerArvore(index) {
            const arvore = dadosArvores[index];
            
            if (!confirm(`Tem certeza que deseja remover a árvore "${arvore.nome}"?\n\nEssa ação não pode ser desfeita.`)) {
                return;
            }

            try {
                const response = await fetch(`${SUPABASE_URL}/rest/v1/arvores?id=eq.${arvore.id}`, {
                    method: 'DELETE',
                    headers: {
                        'apikey': SUPABASE_ANON_KEY,
                        'Authorization': `Bearer ${SUPABASE_ANON_KEY}`
                    }
                });

                if (!response.ok) {
                    throw new Error('Erro ao remover');
                }

                dadosArvores.splice(index, 1);
                
                const select = document.getElementById('selectArvores');
                select.innerHTML = '<option value="">-- Escolha uma árvore --</option>';
                dadosArvores.forEach((a, i) => {
                    const option = document.createElement('option');
                    option.value = i;
                    option.textContent = a.nome;
                    select.appendChild(option);
                });

                document.getElementById('detalhesArvore').style.display = 'none';
                
                alert(`✅ Árvore "${arvore.nome}" removida com sucesso!`);
            } catch (err) {
                alert(`❌ Erro ao remover: ${err.message}`);
                console.error('Erro:', err);
            }
        }

        async function removerMetal(index) {
            const metal = dadosMetais[index];
            
            if (!confirm(`Tem certeza que deseja remover o metal "${metal.nome}"?\n\nEssa ação não pode ser desfeita.`)) {
                return;
            }

            try {
                const response = await fetch(`${SUPABASE_URL}/rest/v1/metais?id=eq.${metal.id}`, {
                    method: 'DELETE',
                    headers: {
                        'apikey': SUPABASE_ANON_KEY,
                        'Authorization': `Bearer ${SUPABASE_ANON_KEY}`
                    }
                });

                if (!response.ok) {
                    throw new Error('Erro ao remover');
                }

                dadosMetais.splice(index, 1);
                
                const select = document.getElementById('selectMetais');
                select.innerHTML = '<option value="">-- Escolha um metal --</option>';
                dadosMetais.forEach((m, i) => {
                    const option = document.createElement('option');
                    option.value = i;
                    option.textContent = m.nome;
                    select.appendChild(option);
                });

                document.getElementById('detalhesMetal').style.display = 'none';
                
                alert(`✅ Metal "${metal.nome}" removido com sucesso!`);
            } catch (err) {
                alert(`❌ Erro ao remover: ${err.message}`);
                console.error('Erro:', err);
            }
        }

        function atualizarFormulario() {
            const tipo = document.getElementById('tipoElemento').value;
            const formArvore = document.getElementById('formArvore');
            const formMetal = document.getElementById('formMetal');
            const mensagem = document.getElementById('mensagemAdicionar');

            formArvore.classList.add('hidden');
            formMetal.classList.add('hidden');
            mensagem.innerHTML = '';

            if (tipo === 'arvore') {
                formArvore.classList.remove('hidden');
            } else if (tipo === 'metal') {
                formMetal.classList.remove('hidden');
            }
        }

        async function adicionarArvore() {
            const nome = document.getElementById('nomeArvore').value.trim();
            const tipo = document.getElementById('tipoArvore').value.trim();
            const status = document.getElementById('statusArvore').value;
            const dataPlantio = document.getElementById('dataPlantioArvore').value;
            const descricao = document.getElementById('descricaoArvore').value.trim();
            const mensagem = document.getElementById('mensagemAdicionar');
            const btn = document.getElementById('btnAdicionarArvore');

            if (!nome) {
                mensagem.innerHTML = '<div class="error">⚠️ O nome é obrigatório!</div>';
                return;
            }

            btn.disabled = true;
            btn.textContent = 'Adicionando...';

            try {
                const response = await fetch(`${SUPABASE_URL}/rest/v1/arvores`, {
                    method: 'POST',
                    headers: {
                        'apikey': SUPABASE_ANON_KEY,
                        'Authorization': `Bearer ${SUPABASE_ANON_KEY}`,
                        'Content-Type': 'application/json',
                        'Prefer': 'return=representation'
                    },
                    body: JSON.stringify({
                        nome: nome,
                        tipo: tipo || null,
                        status: status || null,
                        data_para_plantio: dataPlantio || null,
                        descricao: descricao || null
                    })
                });

                if (!response.ok) {
                    throw new Error('Erro ao adicionar árvore');
                }

                const novaArvore = await response.json();
                
                dadosArvores.push(novaArvore[0]);
                
                const select = document.getElementById('selectArvores');
                const option = document.createElement('option');
                option.value = dadosArvores.length - 1;
                option.textContent = novaArvore[0].nome;
                select.appendChild(option);

                document.getElementById('tipoElemento').value = '';
                document.getElementById('formArvore').classList.add('hidden');

                document.getElementById('nomeArvore').value = '';
                document.getElementById('tipoArvore').value = '';
                document.getElementById('statusArvore').value = '';
                document.getElementById('dataPlantioArvore').value = '';
                document.getElementById('descricaoArvore').value = '';

                mensagem.innerHTML = `<div class="success">✅ Árvore "${novaArvore[0].nome}" adicionada com sucesso!</div>`;
            } catch (err) {
                mensagem.innerHTML = `<div class="error">❌ Erro ao adicionar árvore: ${err.message}</div>`;
                console.error('Erro:', err);
            } finally {
                btn.disabled = false;
                btn.textContent = 'Adicionar Árvore';
            }
        }

        async function adicionarMetal() {
            const nome = document.getElementById('nomeMetal').value.trim();
            const simbolo = document.getElementById('simboloMetal').value.trim();
            const descricao = document.getElementById('descricaoMetal').value.trim();
            const mensagem = document.getElementById('mensagemAdicionar');
            const btn = document.getElementById('btnAdicionarMetal');

            if (!nome) {
                mensagem.innerHTML = '<div class="error">⚠️ O nome é obrigatório!</div>';
                return;
            }

            btn.disabled = true;
            btn.textContent = 'Adicionando...';

            try {
                const response = await fetch(`${SUPABASE_URL}/rest/v1/metais`, {
                    method: 'POST',
                    headers: {
                        'apikey': SUPABASE_ANON_KEY,
                        'Authorization': `Bearer ${SUPABASE_ANON_KEY}`,
                        'Content-Type': 'application/json',
                        'Prefer': 'return=representation'
                    },
                    body: JSON.stringify({
                        nome: nome,
                        simbolo_quimico: simbolo || null,
                        descricao: descricao || null
                    })
                });

                if (!response.ok) {
                    throw new Error('Erro ao adicionar metal');
                }

                const novoMetal = await response.json();
                
                dadosMetais.push(novoMetal[0]);
                
                const select = document.getElementById('selectMetais');
                const option = document.createElement('option');
                option.value = dadosMetais.length - 1;
                option.textContent = novoMetal[0].nome;
                select.appendChild(option);

                document.getElementById('tipoElemento').value = '';
                document.getElementById('formMetal').classList.add('hidden');

                document.getElementById('nomeMetal').value = '';
                document.getElementById('simboloMetal').value = '';
                document.getElementById('descricaoMetal').value = '';

                mensagem.innerHTML = `<div class="success">✅ Metal "${novoMetal[0].nome}" adicionado com sucesso!</div>`;
            } catch (err) {
                mensagem.innerHTML = `<div class="error">❌ Erro ao adicionar metal: ${err.message}</div>`;
                console.error('Erro:', err);
            } finally {
                btn.disabled = false;
                btn.textContent = 'Adicionar Metal';
            }
        }

        function abrirDashboard() {
            if (dadosArvores.length === 0) {
                alert('⚠️ Não há árvores para exibir no dashboard!');
                return;
            }

            const overlay = document.getElementById('dashboardOverlay');
            const track = document.getElementById('dashboardTrack');

            track.innerHTML = '';
            const cardsHTML = dadosArvores.map(arvore => `
                <div class="dashboard-card">
                    <h3>${arvore.nome}</h3>
                    <p><span class="label">Descrição:</span></p>
                    <p>${arvore.descricao || 'Sem descrição'}</p>
                    <p style="margin-top: 20px;"><span class="label">Criado em:</span></p>
                    <p>${new Date(arvore.created_at).toLocaleString('pt-BR')}</p>
                </div>
            `).join('');

            track.innerHTML = cardsHTML + cardsHTML;

            const cardCount = dadosArvores.length;
            track.style.setProperty('--card-count', cardCount);

            overlay.classList.add('active');
        }

        function fecharDashboard() {
            const overlay = document.getElementById('dashboardOverlay');
            overlay.classList.remove('active');
        }
    </script>
</body>
</html>
