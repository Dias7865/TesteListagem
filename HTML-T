async function verificarEArquivarAutomatico() {
    const hoje = new Date();
    hoje.setHours(0, 0, 0, 0);

    for (const tarefa of dadosTarefas) {
        const status = (tarefa.status || '').toLowerCase();
        const eConcluida = status.includes('conclu');

        if (eConcluida && tarefa.data_para_termino) {
            const [ano, mes, dia] = tarefa.data_para_termino.split('T')[0].split('-');
            const dataTarefa = new Date(ano, mes - 1, dia);
            const diffDias = Math.floor((hoje.getTime() - dataTarefa.getTime()) / (1000 * 60 * 60 * 24));

            if (diffDias >= 60) {
                try {
                    const integrador = dadosIntegradores.find(i => i.id === tarefa.intg_id);
                    const integradorNome = integrador ? integrador.nome : 'Não especificado';

                    const resInsert = await fetch(`${SUPABASE_URL}/rest/v1/trfsconcluidas`, {
                        method: 'POST',
                        headers: {
                            'apikey': SUPABASE_ANON_KEY,
                            'Authorization': `Bearer ${SUPABASE_ANON_KEY}`,
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({
                            nome: tarefa.nome,
                            tipo: tarefa.tipo,
                            descricao: tarefa.descricao,
                            intg_fz: integradorNome,
                            data_finalizado: tarefa.data_para_termino.split('T')[0],
                            endereco: tarefa.endereco,
                            data_inicio_obra: tarefa.data_inicio_obra,
                            relatorio_atividades: tarefa.relatorio_atividades
                        })
                    });

                    if (resInsert.ok) {
                        await fetch(`${SUPABASE_URL}/rest/v1/tarefas?id=eq.${tarefa.id}`, {
                            method: 'DELETE',
                            headers: { 'apikey': SUPABASE_ANON_KEY, 'Authorization': `Bearer ${SUPABASE_ANON_KEY}` }
                        });
                    }
                } catch (err) {
                    console.error(`Erro ao arquivar tarefa ID ${tarefa.id}:`, err);
                }
            }
        }
    }
}

function notificarSincronizacao() {
    const ind = document.getElementById('syncIndicator');
    if (ind) {
        const agora = new Date();
        const hora = String(agora.getHours()).padStart(2, '0');
        const min = String(agora.getMinutes()).padStart(2, '0');
        const seg = String(agora.getSeconds()).padStart(2, '0');
        ind.textContent = `🟢 Sincronizado às ${hora}:${min}:${seg}`;
    }

    const paineis = document.querySelectorAll('.painel-com-rotulo');
    paineis.forEach(p => p.classList.add('pulse-update'));

    setTimeout(() => {
        paineis.forEach(p => p.classList.remove('pulse-update'));
    }, 1000);
}
