<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Leitor de Dados - Árvores e Metais</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
        }

        .container {
            max-width: 800px;
            margin: 0 auto;
        }

        h1 {
            text-align: center;
            color: white;
            margin-bottom: 30px;
            font-size: 2.5rem;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
        }

        .section {
            background: white;
            border-radius: 12px;
            padding: 30px;
            margin-bottom: 30px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
        }

        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            border-bottom: 2px solid #f0f0f0;
            padding-bottom: 15px;
        }

        h2 {
            color: #333;
            font-size: 1.8rem;
        }

        .btn {
            padding: 12px 24px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-size: 16px;
            font-weight: bold;
            transition: transform 0.2s, box-shadow 0.2s;
        }

        .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4);
        }

        .btn:active {
            transform: translateY(0);
        }

        .btn:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }

        .btn-success {
            background: linear-gradient(135deg, #4caf50 0%, #45a049 100%);
        }

        .btn-success:hover {
            box-shadow: 0 5px 15px rgba(76, 175, 80, 0.4);
        }

        .btn-warning {
            background: linear-gradient(135deg, #ff9800 0%, #f57c00 100%);
        }

        .btn-warning:hover {
            box-shadow: 0 5px 15px rgba(255, 152, 0, 0.4);
        }

        .btn-danger {
            background: linear-gradient(135deg, #f44336 0%, #d32f2f 100%);
        }

        .btn-danger:hover {
            box-shadow: 0 5px 15px rgba(244, 67, 54, 0.4);
        }

        .btn-secondary {
            background: linear-gradient(135deg, #9e9e9e 0%, #757575 100%);
        }

        .btn-dashboard {
            background: linear-gradient(135deg, #00bcd4 0%, #0097a7 100%);
            width: 100%;
            padding: 15px;
            font-size: 18px;
        }

        .btn-dashboard:hover {
            box-shadow: 0 5px 15px rgba(0, 188, 212, 0.4);
        }

        .loading {
            text-align: center;
            padding: 20px;
            color: #667eea;
            font-size: 1.1rem;
        }

        .error {
            background: #fee;
            border: 1px solid #fcc;
            color: #c33;
            padding: 15px;
            border-radius: 8px;
            margin-top: 15px;
        }

        .success {
            background: #e8f5e9;
            border: 1px solid #4caf50;
            color: #2e7d32;
            padding: 15px;
            border-radius: 8px;
            margin-top: 15px;
        }

        .verificacao-container {
            display: flex;
            gap: 10px;
            align-items: center;
            margin-top: 15px;
        }

        .verificacao-container input {
            flex: 1;
            padding: 12px 16px;
            border: 2px solid #e0e0e0;
            border-radius: 8px;
            font-size: 16px;
            transition: border-color 0.3s;
        }

        .verificacao-container input:focus {
            outline: none;
            border-color: #667eea;
        }

        .mensagem-resultado {
            margin-top: 15px;
            padding: 15px 20px;
            border-radius: 8px;
            font-size: 1.2rem;
            font-weight: bold;
            text-align: center;
            display: none;
            animation: fadeIn 0.3s ease-in-out;
        }

        .mensagem-sucesso {
            background: #e8f5e9;
            border: 2px solid #4caf50;
            color: #2e7d32;
        }

        .mensagem-erro {
            background: #fce4ec;
            border: 2px solid #f44336;
            color: #c62828;
        }

        .seletor-container {
            margin-bottom: 20px;
        }

        .seletor-container label {
            display: block;
            margin-bottom: 8px;
            font-weight: bold;
            color: #555;
            font-size: 1rem;
        }

        .seletor-container select {
            width: 100%;
            padding: 12px 16px;
            border: 2px solid #e0e0e0;
            border-radius: 8px;
            font-size: 16px;
            background-color: white;
            cursor: pointer;
            transition: border-color 0.3s;
        }

        .seletor-container select:focus {
            outline: none;
            border-color: #667eea;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-weight: bold;
            color: #555;
            font-size: 1rem;
        }

        .form-group input,
        .form-group textarea,
        .form-group select {
            width: 100%;
            padding: 12px 16px;
            border: 2px solid #e0e0e0;
            border-radius: 8px;
            font-size: 16px;
            transition: border-color 0.3s;
            font-family: inherit;
        }

        .form-group textarea {
            resize: vertical;
            min-height: 80px;
        }

        .form-group input:focus,
        .form-group textarea:focus,
        .form-group select:focus {
            outline: none;
            border-color: #667eea;
        }

        .detalhes-card {
            background: #f9f9f9;
            border-radius: 10px;
            padding: 25px;
            border-left: 4px solid #667eea;
            margin-top: 20px;
            animation: fadeIn 0.3s ease-in-out;
        }

        .detalhes-card h3 {
            color: #333;
            margin-bottom: 15px;
            font-size: 1.6rem;
            text-transform: capitalize;
        }

        .detalhes-card p {
            color: #666;
            margin: 10px 0;
            line-height: 1.6;
            font-size: 1rem;
        }

        .detalhes-card .label {
            font-weight: bold;
            color: #764ba2;
        }

        .detalhes-card .badge {
            display: inline-block;
            background: #667eea;
            color: white;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.85rem;
            margin-left: 8px;
        }

        .status-badge {
            display: inline-block;
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 0.9rem;
            font-weight: bold;
            margin-left: 8px;
        }

        .status-plantado {
            background: #4caf50;
            color: white;
        }

        .status-aguardando {
            background: #ff9800;
            color: white;
        }

        .status-nao-plantado {
            background: #f44336;
            color: white;
        }

        .action-buttons {
            display: flex;
            gap: 10px;
            margin-top: 20px;
            flex-wrap: wrap;
        }

        .action-buttons .btn {
            flex: 1;
            min-width: 150px;
        }

        .edit-form {
            background: #fff8e1;
            border: 2px solid #ff9800;
            border-radius: 10px;
            padding: 20px;
            margin-top: 20px;
            animation: fadeIn 0.3s ease-in-out;
        }

        .edit-form h4 {
            color: #f57c00;
            margin-bottom: 15px;
            font-size: 1.3rem;
        }

        .dashboard-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
            z-index: 9999;
            display: none;
            overflow: hidden;
        }

        .dashboard-overlay.active {
            display: block;
        }

        .dashboard-close {
            position: absolute;
            top: 30px;
            right: 30px;
            width: 50px;
            height: 50px;
            background: rgba(255, 255, 255, 0.1);
            border: 2px solid rgba(255, 255, 255, 0.3);
            border-radius: 50%;
            color: white;
            font-size: 28px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s;
            z-index: 10000;
        }

        .dashboard-close:hover {
            background: rgba(244, 67, 54, 0.8);
            border-color: #f44336;
            transform: rotate(90deg);
        }

        .dashboard-title {
            position: absolute;
            top: 40px;
            left: 50%;
            transform: translateX(-50%);
            color: white;
            font-size: 2.5rem;
            text-shadow: 2px 2px 8px rgba(0,0,0,0.5);
            z-index: 10;
        }

        .dashboard-container {
            position: absolute;
            top: 50%;
            left: 0;
            width: 100%;
            height: 300px;
            transform: translateY(-50%);
            overflow: hidden;
        }

        .dashboard-track {
            display: flex;
            gap: 40px;
            animation: scrollLeft 30s linear infinite;
            height: 100%;
        }

        .dashboard-card {
            flex-shrink: 0;
            width: 400px;
            height: 100%;
            background: linear-gradient(135deg, rgba(102, 126, 234, 0.9) 0%, rgba(118, 75, 162, 0.9) 100%);
            border-radius: 20px;
            padding: 30px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.3);
            display: flex;
            flex-direction: column;
            justify-content: center;
            color: white;
        }

        .dashboard-card h3 {
            font-size: 2rem;
            margin-bottom: 20px;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
        }

        .dashboard-card p {
            font-size: 1.1rem;
            margin: 12px 0;
            line-height: 1.6;
        }

        .dashboard-card .label {
            font-weight: bold;
            font-size: 0.9rem;
            opacity: 0.8;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        @keyframes scrollLeft {
            0% {
                transform: translateX(0);
            }
            100% {
                transform: translateX(calc(-440px * var(--card-count)));
            }
        }

        .hidden {
            display: none !important;
        }

        @keyframes slideIn {
            from { 
                opacity: 0; 
                transform: translateY(20px); 
            }
            to { 
                opacity: 1; 
                transform: translateY(0); 
            }
        }

        .section-revealed {
            animation: slideIn 0.5s ease-out;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(-5px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>🌳 Leitor de Dados Supabase 🪨</h1>

        <div id="secaoVerificacao" class="section">
            <div class="section-header">
                <h2>🔍 Verificação</h2>
            </div>
            <p style="color: #666; margin-bottom: 10px;">
                Digite o código secreto e pressione Enter ou clique em "Verificar" para liberar o acesso às listas:
            </p>
            <div class="verificacao-container">
                <input type="text" id="inputVerificacao" placeholder="Digite o código aqui..." autocomplete="off">
                <button class="btn" onclick="verificarCodigo()" id="btnVerificar">Verificar</button>
            </div>
            <div id="mensagemResultado" class="mensagem-resultado"></div>
        </div>

        <div id="secaoArvores" class="section hidden">
            <div class="section-header">
                <h2>🌳 Árvores</h2>
            </div>
            <div class="seletor-container">
                <label for="selectArvores">Selecione uma árvore:</label>
                <select id="selectArvores" onchange="mostrarDetalhesArvore()">
                    <option value="">-- Escolha uma árvore --</option>
                </select>
            </div>
            <div id="arvoresLoading" class="loading" style="display: none;">
                Carregando árvores...
            </div>
            <div id="arvoresError" class="error" style="display: none;"></div>
            <div id="detalhesArvore" class="detalhes-card" style="display: none;"></div>
        </div>

        <div id="secaoMetais" class="section hidden">
            <div class="section-header">
                <h2>🪨 Metais</h2>
            </div>
            <div class="seletor-container">
                <label for="selectMetais">Selecione um metal:</label>
                <select id="selectMetais" onchange="mostrarDetalhesMetal()">
                    <option value="">-- Escolha um metal --</option>
                </select>
            </div>
            <div id="metaisLoading" class="loading" style="display: none;">
                Carregando metais...
            </div>
            <div id="metaisError" class="error" style="display: none;"></div>
            <div id="detalhesMetal" class="detalhes-card" style="display: none;"></div>
        </div>

        <div id="secaoDashboard" class="section hidden">
            <div class="section-header">
                <h2>📊 Dashboard</h2>
            </div>
            <p style="color: #666; margin-bottom: 20px;">
                Visualize todas as árvores em um carrossel animado em tela cheia:
            </p>
            <button class="btn btn-dashboard" onclick="abrirDashboard()">
                🎬 Abrir Dashboard de Árvores
            </button>
        </div>

        <div id="secaoAdicionar" class="section hidden">
            <div class="section-header">
                <h2>➕ Adicionar Elemento</h2>
            </div>
            <p style="color: #666; margin-bottom: 20px;">
                Crie um novo elemento para uma das listas existentes:
            </p>

            <div class="form-group">
                <label for="tipoElemento">Tipo de Elemento:</label>
                <select id="tipoElemento" onchange="atualizarFormulario()">
                    <option value="">-- Selecione o tipo --</option>
                    <option value="arvore">🌳 Árvore</option>
                    <option value="metal">🪨 Metal</option>
                </select>
            </div>

            <div id="formArvore" class="hidden">
                <div class="form-group">
                    <label for="nomeArvore">Nome da Árvore:</label>
                    <input type="text" id="nomeArvore" placeholder="Ex: Mangueira">
                </div>
                <div class="form-group">
                    <label for="tipoArvore">Tipo:</label>
                    <input type="text" id="tipoArvore" placeholder="Ex: Frutífera">
                </div>
                <div class="form-group">
                    <label for="statusArvore">Status:</label>
                    <select id="statusArvore">
                        <option value="">-- Selecione o status --</option>
                        <option value="plantado">🌱 Plantado</option>
                        <option value="aguardando fertilizante">⏳ Aguardando Fertilizante</option>
                        <option value="não plantado">❌ Não Plantado</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="dataPlantioArvore">Data Para Plantio:</label>
                    <input type="date" id="dataPlantioArvore">
                </div>
                <div class="form-group">
                    <label for="descricaoArvore">Descrição:</label>
                    <textarea id="descricaoArvore" placeholder="Descreva a árvore..."></textarea>
                </div>
                <button class="btn btn-success" onclick="adicionarArvore()" id="btnAdicionarArvore">
                    Adicionar Árvore
                </button>
            </div>

            <div id="formMetal" class="hidden">
                <div class="form-group">
                    <label for="nomeMetal">Nome do Metal:</label>
                    <input type="text" id="nomeMetal" placeholder="Ex: Cobre">
                </div>
                <div class="form-group">
                    <label for="simboloMetal">Símbolo Químico:</label>
                    <input type="text" id="simboloMetal" placeholder="Ex: Cu" maxlength="10">
                </div>
                <div class="form-group">
                    <label for="descricaoMetal">Descrição:</label>
                    <textarea id="descricaoMetal" placeholder="Descreva o metal..."></textarea>
                </div>
                <button class="btn btn-success" onclick="adicionarMetal()" id="btnAdicionarMetal">
                    Adicionar Metal
                </button>
            </div>

            <div id="mensagemAdicionar" style="margin-top: 15px;"></div>
        </div>
    </div>

    <div id="dashboardOverlay" class="dashboard-overlay">
        <button class="dashboard-close" onclick="fecharDashboard()">✕</button>
        <h1 class="dashboard-title">🌳 Dashboard de Árvores</h1>
        <div class="dashboard-container">
            <div id="dashboardTrack" class="dashboard-track"></div>
        </div>
    </div>

    <script>
        const SUPABASE_URL = 'https://iajsciazkrtyqhlurvsi.supabase.co';
        const SUPABASE_ANON_KEY = 'sb_publishable_vJZfKGSKgljFrTJ4X4exUg_Z1xMQ0tN';

        let dadosArvores = [];
        let dadosMetais = [];

        async function verificarCodigo() {
            const input = document.getElementById('inputVerificacao');
            const texto = input.value;
            const mensagem = document.getElementById('mensagemResultado');
            const btn = document.getElementById('btnVerificar');

            if (!texto) {
                mensagem.textContent = '⚠️ Por favor, digite algo!';
                mensagem.classList.remove('mensagem-sucesso', 'mensagem-erro');
                mensagem.classList.add('mensagem-erro');
                mensagem.style.display = 'block';
                return;
            }

            btn.disabled = true;
            btn.textContent = 'Verificando...';

            try {
                const response = await fetch(
                    `${SUPABASE_URL}/rest/v1/rpc/verificar_senha`,
                    {
                        method: 'POST',
                        headers: {
                            'apikey': SUPABASE_ANON_KEY,
                            'Authorization': `Bearer ${SUPABASE_ANON_KEY}`,
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({ texto_inserido: texto })
                    }
                );

                if (!response.ok) {
                    const errorText = await response.text();
                    console.error('Erro do servidor:', response.status, errorText);
                    throw new Error(`Erro ${response.status}: ${errorText}`);
                }

                const resultado = await response.json();

                mensagem.classList.remove('mensagem-sucesso', 'mensagem-erro');

                if (resultado === true) {
                    mensagem.textContent = '✅ Tudo certo — acesso liberado!';
                    mensagem.classList.add('mensagem-sucesso');
                    mensagem.style.display = 'block';
                    
                    setTimeout(() => {
                        document.getElementById('secaoVerificacao').classList.add('hidden');
                        revelarSecoes();
                        carregarDadosIniciais();
                    }, 1000);
                } else {
                    mensagem.textContent = '❌ Deu Errado';
                    mensagem.classList.add('mensagem-erro');
                    mensagem.style.display = 'block';
                }
            } catch (err) {
                mensagem.textContent = '❌ Erro ao verificar no servidor!';
                mensagem.classList.remove('mensagem-sucesso');
                mensagem.classList.add('mensagem-erro');
                mensagem.style.display = 'block';
                console.error('Erro completo:', err);
            } finally {
                btn.disabled = false;
                btn.textContent = 'Verificar';
            }
        }

        function revelarSecoes() {
            const secaoArvores = document.getElementById('secaoArvores');
            const secaoMetais = document.getElementById('secaoMetais');
            const secaoDashboard = document.getElementById('secaoDashboard');
            const secaoAdicionar = document.getElementById('secaoAdicionar');

            secaoArvores.classList.remove('hidden');
            secaoArvores.classList.add('section-revealed');

            secaoMetais.classList.remove('hidden');
            secaoMetais.classList.add('section-revealed');

            secaoDashboard.classList.remove('hidden');
            secaoDashboard.classList.add('section-revealed');

            secaoAdicionar.classList.remove('hidden');
            secaoAdicionar.classList.add('section-revealed');
        }

        async function carregarDadosIniciais() {
            await carregarArvores();
            await carregarMetais();
        }

        document.getElementById('inputVerificacao').addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                verificarCodigo();
            }
        });

        async function buscarDados(tabela) {
            try {
                const response = await fetch(`${SUPABASE_URL}/rest/v1/${tabela}?select=*`, {
                    method: 'GET',
                    headers: {
                        'apikey': SUPABASE_ANON_KEY,
                        'Authorization': `Bearer ${SUPABASE_ANON_KEY}`,
                        'Content-Type': 'application/json'
                    }
                });

                if (!response.ok) {
                    throw new Error(`Erro na requisição: ${response.status}`);
                }

                const data = await response.json();
                return data;
            } catch (error) {
                console.error(`Erro ao buscar ${tabela}:`, error);
                throw error;
            }
        }

        async function carregarArvores() {
            const loading = document.getElementById('arvoresLoading');
            const error = document.getElementById('arvoresError');
            const select = document.getElementById('selectArvores');

            error.style.display = 'none';
            loading.style.display = 'block';

            try {
                dadosArvores = await buscarDados('arvores');
                loading.style.display = 'none';

                select.innerHTML = '<option value="">-- Escolha uma árvore --</option>';

                dadosArvores.forEach((arvore, index) => {
                    const option = document.createElement('option');
                    option.value = index;
                    option.textContent = arvore.nome;
                    select.appendChild(option);
                });
            } catch (err) {
                loading.style.display = 'none';
                error.textContent = `❌ Erro ao carregar árvores: ${err.message}`;
                error.style.display = 'block';
            }
        }

        async function carregarMetais() {
            const loading = document.getElementById('metaisLoading');
            const error = document.getElementById('metaisError');
            const select = document.getElementById('selectMetais');

            error.style.display = 'none';
            loading.style.display = 'block';

            try {
                dadosMetais = await buscarDados('metais');
                loading.style.display = 'none';

                select.innerHTML = '<option value="">-- Escolha um metal --</option>';

                dadosMetais.forEach((metal, index) => {
                    const option = document.createElement('option');
                    option.value = index;
                    option.textContent = metal.nome;
                    select.appendChild(option);
                });
            } catch (err) {
                loading.style.display = 'none';
                error.textContent = `❌ Erro ao carregar metais: ${err.message}`;
                error.style.display = 'block';
            }
        }

        function formatarData(dataISO) {
            if (!dataISO) return 'Não definida';
            const data = new Date(dataISO);
            const dia = String(data.getDate()).padStart(2, '0');
            const mes = String(data.getMonth() + 1).padStart(2, '0');
            const ano = data.getFullYear();
            return `${dia}/${mes}/${ano}`;
        }

        function getStatusBadge(status) {
            if (!status) return '<span class="status-badge status-nao-plantado">Não definido</span>';
            
            const statusLower = status.toLowerCase();
            if (statusLower === 'plantado') {
                return `<span class="status-badge status-plantado">🌱 ${status}</span>`;
            } else if (statusLower === 'aguardando fertilizante') {
                return `<span class="status-badge status-aguardando">⏳ ${status}</span>`;
            } else {
                return `<span class="status-badge status-nao-plantado">❌ ${status}</span>`;
            }
        }

        function mostrarDetalhesArvore() {
            const select = document.getElementById('selectArvores');
            const detalhesDiv = document.getElementById('detalhesArvore');
            const index = select.value;

            if (index === '') {
                detalhesDiv.style.display = 'none';
                return;
            }

            const arvore = dadosArvores[index];
            detalhesDiv.innerHTML = `
                <h3>${arvore.nome}</h3>
                <p><span class="label">Tipo:</span> ${arvore.tipo || 'Não informado'}</p>
                <p><span class="label">Status:</span> ${getStatusBadge(arvore.status)}</p>
                <p><span class="label">Data Para Plantio:</span> ${formatarData(arvore.data_para_plantio)}</p>
                <p><span class="label">Descrição:</span> ${arvore.descricao || 'Sem descrição'}</p>
                <p><span class="label">ID:</span> <code>${arvore.id}</code></p>
                <p><span class="label">Criado em:</span> ${new Date(arvore.created_at).toLocaleString('pt-BR')}</p>
                <div class="action-buttons">
                    <button class="btn btn-warning" onclick="abrirEdicaoArvore(${index})">✏️ Modificar Elemento</button>
                    <button class="btn btn-danger" onclick="removerArvore(${index})">🗑️ Remover Elemento</button>
                </div>
                <div id="editFormArvore"></div>
            `;
            detalhesDiv.style.display = 'block';
        }

        function mostrarDetalhesMetal() {
            const select = document.getElementById('selectMetais');
            const detalhesDiv = document.getElementById('detalhesMetal');
            const index = select.value;

            if (index === '') {
                detalhesDiv.style.display = 'none';
                return;
            }

            const metal = dadosMetais[index];
            detalhesDiv.innerHTML = `
                <h3>${metal.nome}</h3>
                <p><span class="label">Símbolo Químico:</span> <span class="badge">${metal.simbolo_quimico || 'N/A'}</span></p>
                <p><span class="label">Descrição:</span> ${metal.descricao || 'Sem descrição'}</p>
                <p><span class="label">ID:</span> <code>${metal.id}</code></p>
                <p><span class="label">Criado em:</span> ${new Date(metal.created_at).toLocaleString('pt-BR')}</p>
                <div class="action-buttons">
                    <button class="btn btn-warning" onclick="abrirEdicaoMetal(${index})">✏️ Modificar Elemento</button>
