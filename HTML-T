async function concluirEArquivarTarefa(index) {
    const tarefa = dadosTarefas[index];
    const integrador = dadosIntegradores.find(i => i.id === tarefa.intg_id);
    const integradorNome = integrador ? integrador.nome : 'Não especificado';

    if (!confirm(`Deseja marcar a tarefa "${tarefa.nome}" como concluída e movê-la para o histórico?`)) return;

    try {
        // 1. Insere na tabela trfsconcluidas
        const resInsert = await fetch(`${SUPABASE_URL}/rest/v1/trfsconcluidas`, {
            method: 'POST',
            headers: {
                'apikey': SUPABASE_ANON_KEY,
                'Authorization': `Bearer ${SUPABASE_ANON_KEY}`,
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                nome: tarefa.nome,
                tipo: tarefa.tipo,
                descricao: tarefa.descricao,
                intg_fz: integradorNome,
                data_finalizado: new Date().toISOString().split('T')[0]
            })
        });

        if (!resInsert.ok) throw new Error('Erro ao arquivar tarefa concluída.');

        // 2. Remove da tabela tarefas
        await fetch(`${SUPABASE_URL}/rest/v1/tarefas?id=eq.${tarefa.id}`, {
            method: 'DELETE',
            headers: { 'apikey': SUPABASE_ANON_KEY, 'Authorization': `Bearer ${SUPABASE_ANON_KEY}` }
        });

        document.getElementById('detalhesTarefa').style.display = 'none';
        await carregarTarefas();
        await carregarTrfsConcluidas();
        await carregarPagina1();
        alert('✅ Tarefa concluída e arquivada com sucesso!');
    } catch (err) {
        alert(`❌ Erro: ${err.message}`);
    }
}

async function removerTrfConcluida(index) {
    const tc = dadosTrfsConcluidas[index];
    if (!confirm(`Remover "${tc.nome}" do histórico de concluídas?`)) return;

    try {
        await fetch(`${SUPABASE_URL}/rest/v1/trfsconcluidas?id=eq.${tc.id}`, {
            method: 'DELETE',
            headers: { 'apikey': SUPABASE_ANON_KEY, 'Authorization': `Bearer ${SUPABASE_ANON_KEY}` }
