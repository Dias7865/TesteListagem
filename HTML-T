<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Leitor de Dados - Matssa</title>
<link rel="icon" type="image/webp" href="https://iajsciazkrtyqhlurvsi.supabase.co/storage/v1/object/public/D78Imagens/fvfvsf.webp">
<style>
* { margin: 0; padding: 0; box-sizing: border-box; }
body {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    background-image: url('https://iajsciazkrtyqhlurvsi.supabase.co/storage/v1/object/public/D78Imagens/planofspl.webp');
    background-repeat: repeat-x;
    background-size: 100vw 150vh;
    background-attachment: fixed;
    animation: moverFundo 40s steps(1200) infinite;

    min-height: 100vh;
    padding: 20px;
    zoom: 75%;
}

@keyframes moverFundo {
    0% {
        background-position-x: 0;
    }
    100% {
        background-position-x: -100vw;
    }
}

.container { max-width: 1250px; margin: 0 auto; }

h1 {
    text-align: center; color: white; margin-bottom: 25px;
    font-size: 2.5rem; text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
}
.section {
    background: white; border-radius: 12px; padding: 30px;
    margin-bottom: 20px; box-shadow: 0 10px 30px rgba(0,0,0,0.2);
}
.section-header {
    display: flex; justify-content: space-between; align-items: center;
    margin-bottom: 20px; border-bottom: 2px solid #f0f0f0; padding-bottom: 15px;
}
h2 { color: #333; font-size: 1.8rem; }
.btn {
    padding: 12px 24px;
    background: #4f46e5; /* Azul/Roxo fosco */
    color: white; border: none; border-radius: 8px; cursor: pointer;
    font-size: 16px; font-weight: bold;
    transition: transform 0.2s, box-shadow 0.2s;
}
.btn:hover { transform: translateY(-2px); box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4); }
.btn:disabled { opacity: 0.6; cursor: not-allowed; }
.btn-success { background: #2e7d32; } /* Verde fosco */
.btn-warning { background: #e65100; } /* Laranja fosco */
.btn-danger  { background: #c62828; } /* Vermelho fosco */
.btn-secondary { background: #616161; } /* Cinza fosco */

.loading { text-align: center; padding: 20px; color: #00730d; font-size: 1.1rem; }
.error { background: #fee; border: 1px solid #fcc; color: #c33; padding: 15px; border-radius: 8px; margin-top: 15px; }

.imagem-login {
    width: 100%;
    max-width: 400px;
    height: 180px;
    object-fit: cover;
    border-radius: 8px;
    display: block;
    margin: 0 auto 15px auto;
}

#secaoVerificacao {
    max-width: 800px;
    margin: 18vh auto 20px auto;
    text-align: center;
}

.verificacao-container {
    display: flex;
    gap: 10px;
    align-items: center;
    justify-content: center;
    max-width: 400px;
    margin: 15px auto 0 auto;
}
.verificacao-container input {
    flex: 1; padding: 12px 16px; border: 2px solid #e0e0e0;
    border-radius: 8px; font-size: 16px;
}
.mensagem-resultado {
    margin-top: 15px; padding: 15px 20px; border-radius: 8px;
    font-size: 1.2rem; font-weight: bold; text-align: center; display: none;
}
.mensagem-sucesso { background: #e8f5e9; border: 2px solid #4caf50; color: #2e7d32; }
.mensagem-erro { background: #fce4ec; border: 2px solid #f44336; color: #c62828; }

/* --- ESTRUTURA LAYOUT DA 1ª PÁGINA --- */
.p1-topo {
    display: grid; grid-template-columns: 1fr 200px; gap: 15px; margin-bottom: 15px; align-items: stretch;
}

.painel-com-rotulo {
    background: white; border: 4px solid #1a1a1a; border-radius: 12px;
    padding: 15px; display: flex; align-items: center; gap: 15px;
    box-shadow: 0 8px 20px rgba(0,0,0,0.15);
}

.rotulo-vertical {
    writing-mode: vertical-rl; transform: rotate(180deg); text-align: center;
    font-weight: bold; font-size: 1.1rem; color: #1a1a1a;
    border-left: 3px solid #1a1a1a; padding-left: 8px; white-space: nowrap;
    text-transform: uppercase; letter-spacing: 1px;
}

.grid-caixas-status, .grid-caixas-prazos {
    display: flex; gap: 15px; flex-wrap: wrap; justify-content: space-around; align-items: flex-start; flex: 1;
}

.item-caixa-status, .item-caixa-prazo {
    display: flex; flex-direction: column; align-items: center; justify-content: flex-start; width: 140px;
}

.item-caixa-status .caixa-quantidade {
    width: 100%; height: 105px; border: 4px solid #1a1a1a; background: #f9f9f9;
    display: flex; align-items: center; justify-content: center;
    font-size: 2.8rem; font-weight: bold; color: #ffffff; border-radius: 8px;
    box-shadow: 2px 4px 10px rgba(0,0,0,0.1); flex-shrink: 0;
}

.item-caixa-prazo .caixa-quantidade {
    width: 120px; height: 120px; border: 4px solid #1a1a1a; background: #f9f9f9;
    display: flex; align-items: center; justify-content: center;
    font-size: 2.8rem; font-weight: bold; color: #ffffff; border-radius: 50%;
    box-shadow: 2px 4px 10px rgba(0,0,0,0.1); flex-shrink: 0;
}

.nome-status-caixa, .nome-prazo-caixa {
    margin-top: 8px; font-weight: bold; color: #333; text-align: center;
    font-size: 0.9rem; text-transform: capitalize; line-height: 1.2;
}

.p1-botoes-laterais {
    display: flex;
    flex-direction: column;
    gap: 15px;
    height: 100%;
}
.p1-botoes-laterais .btn-p1-lateral {
    flex: 1;
}

.btn-p1-lateral {
    border: 4px solid #1a1a1a; background: #fff; color: #1a1a1a;
    font-weight: bold; font-size: 1.1rem; cursor: pointer; border-radius: 12px;
    display: flex; align-items: center; justify-content: center; text-align: center;
    padding: 15px; transition: transform 0.2s, background 0.2s;
    box-shadow: 0 8px 20px rgba(0,0,0,0.15); width: 100%; height: 100%;
}
.btn-p1-lateral:hover { background: #1a1a1a; color: #fff; transform: translateY(-3px); }

/* GRID DE 2 COLUNAS NA PÁGINA 1 */
.p1-corpo {
    display: grid; grid-template-columns: 1.8fr 1.4fr; gap: 15px; align-items: stretch;
}
.p1-corpo-esquerda { display: flex; flex-direction: column; gap: 15px; }

.container-lista-pendentes {
    flex: 1; background: white; border: 4px solid #1a1a1a; border-radius: 12px;
    padding: 20px; box-shadow: 0 8px 20px rgba(0,0,0,0.15); min-height: 250px;
}
.lista-vertical-pendentes {
    display: flex; flex-direction: column; gap: 10px; max-height: 250px; overflow-y: auto;
}
.item-pendente {
    display: flex; align-items: center; justify-content: space-between;
    padding: 12px 16px; border-radius: 8px; font-size: 1rem; font-weight: bold;
    color: #ffffff; text-shadow: 1px 1px 2px rgba(0,0,0,0.4);
    box-shadow: 0 2px 6px rgba(0,0,0,0.15);
}
.item-pendente-esquerda { display: flex; align-items: center; gap: 10px; }

/* VISUALIZAÇÃO DINÂMICA EM 2 COLUNAS IGUAIS */
.grid-vis-dinamica {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 15px;
}

.container-vis-dinamica {
    background: white; border: 4px solid #1a1a1a; border-radius: 12px;
    padding: 15px; box-shadow: 0 8px 20px rgba(0,0,0,0.15);
    overflow: hidden; display: flex; flex-direction: column; height: 100%; min-height: 400px; max-height: 480px;
}
.vis-dinamica-titulo {
    font-size: 1rem; font-weight: bold; text-align: center; margin-bottom: 12px;
    padding-bottom: 8px; border-bottom: 2px solid #eee; color: #1a1a1a;
}
.vis-dinamica-viewport { overflow: hidden; flex: 1; position: relative; }
.vis-dinamica-track {
    display: flex; flex-direction: column; gap: 15px;
    animation: scrollUp var(--animation-duration-v, 20s) linear infinite;
}

.p1-titulo-periodo {
    text-align: center;
    color: white;
    font-size: 2.0rem;
    margin-bottom: 5px;
    font-weight: bold;
    text-shadow: 1px 1px 4px rgba(0, 0, 0, 0.3);
}

@keyframes scrollUp {
    0% { transform: translateY(0); }
    100% { transform: translateY(-50%); }
}
.vis-card {
    background: #0e136b; /* Cor fosco */
    color: white; border-radius: 10px; padding: 12px; border: 2px solid #1a1a1a;
    box-shadow: 0 4px 10px rgba(0,0,0,0.15); font-size: 0.9rem;
}
.vis-card h4 { font-size: 1.05rem; margin-bottom: 6px; }
.vis-card p { margin: 4px 0; }

/* --- ESTRUTURA DE LAYOUT DA 2ª PÁGINA --- */
.app-layout {
    display: grid; grid-template-columns: 1.4fr 1fr;
    grid-template-areas:
        "tarefas adicionar"
        "tarefas integradores";
    gap: 20px; align-items: start;
}
.area-tarefas { grid-area: tarefas; }
.area-adicionar { grid-area: adicionar; }
.area-integradores { grid-area: integradores; }
.area-concluidas { grid-area: concluidas; }

@media (max-width: 900px) {
    .p1-topo { grid-template-columns: 1fr; }
    .p1-corpo { grid-template-columns: 1fr; }
    .grid-vis-dinamica { grid-template-columns: 1fr; }
    .app-layout { grid-template-columns: 1fr; grid-template-areas: "tarefas" "adicionar" "integradores"; }
}

.seletor-container { margin-bottom: 20px; }
.seletor-container label { display: block; margin-bottom: 8px; font-weight: bold; color: #555; }
.seletor-container select {
    width: 100%; padding: 12px 16px; border: 2px solid #e0e0e0; border-radius: 8px; font-size: 16px; background-color: white; cursor: pointer;
}
.form-group { margin-bottom: 20px; }
.form-group label { display: block; margin-bottom: 8px; font-weight: bold; color: #555; }
.form-group input, .form-group textarea, .form-group select {
    width: 100%; padding: 12px 16px; border: 2px solid #e0e0e0; border-radius: 8px; font-size: 16px; font-family: inherit;
}
.form-group textarea { resize: vertical; min-height: 80px; }
.detalhes-card { background: #f9f9f9; border-radius: 10px; padding: 25px; border-left: 4px solid #00730d; margin-top: 20px; }
.detalhes-card h3 { color: #333; margin-bottom: 15px; font-size: 1.6rem; }
.detalhes-card p { color: #666; margin: 10px 0; line-height: 1.6; }
.detalhes-card .label { font-weight: bold; color: #764ba2; }
.detalhes-card .label2 { font-weight: bold; color: #9b8cab; }
.detalhes-card .badge { display: inline-block; background: #00730d; color: white; padding: 4px 12px; border-radius: 20px; font-size: 0.85rem; margin-left: 8px; }
.status-badge { display: inline-block; padding: 6px 14px; border-radius: 20px; font-size: 0.85rem; font-weight: bold; }
.status-concluido { background: #2196f3; color: white; }
.status-em-progresso { background: #4caf50; color: white; }
.status-aguardando { background: #ffc229; color: white; }
.status-nao-iniciado { background: #4f0b06; color: white; }
.status-faltam-dados { background: #00802D; color: white; }
.status-reprovado { background: #757575; color: white; }
.action-buttons { display: flex; gap: 10px; margin-top: 20px; flex-wrap: wrap; }
.action-buttons .btn { flex: 1; min-width: 150px; }

.hidden { display: none !important; }

.prazo-no-prazo { background: #4caf50; color: white; }
.prazo-proximo  { background: #ff9800; color: white; }
.prazo-limite   { background: #80004c; color: white; }
.prazo-atrasado { background: #d32f2f; color: white; }

/* Modal */
.modal-overlay {position: fixed; top: 0; left: 0; right: 0; bottom: 0; width: 100%; height: 100%; background: rgba(0, 0, 0, 0.6); backdrop-filter: blur(3px); -webkit-backdrop-filter: blur(3px); z-index: 10000; display: none; align-items: center;justify-content: center;padding: 20px; }
.modal-overlay.active { display: flex; }
.modal-card { background: white; border-radius: 12px; padding: 30px; max-width: 550px; width: 100%; max-height: 90vh; overflow-y: auto; position: relative; box-shadow: 0 10px 30px rgba(0,0,0,0.3); border: 4px solid #ffbd17; }
.modal-close { position: absolute; top: 15px; right: 15px; width: 36px; height: 36px; background: #f0f0f0; border: none; border-radius: 50%; font-size: 20px; font-weight: bold; color: #555; cursor: pointer; display: flex; align-items: center; justify-content: center; }
.modal-close:hover { background: #f44336; color: white; }

.sync-indicator {
    text-align: right;
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.85);
    margin-bottom: 8px;
    font-weight: 600;
    transition: opacity 0.3s ease;
}

.pulse-update {
    animation: brilhoSuave 1s ease-in-out;
}

@keyframes brilhoSuave {
    0% { border-color: #1a1a1a; }
    50% { border-color: #4caf50; box-shadow: 0 0 15px rgba(76, 175, 80, 0.5); }
    100% { border-color: #1a1a1a; }
}
</style>
</head>
<body>
<div class="container">

    <!-- SEÇÃO DE VERIFICAÇÃO DE SENHA -->
    <div id="secaoVerificacao" class="section">
        <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcRejI_5r0R1whefw8AOCBIkthVQxw0BsLOLQcKl6lA25vZP0SCWo9s1EE2U&s=10" alt="Login" class="imagem-login">
        <div class="section-header"><h2>🔍 Verificação</h2></div>
        <p style="color:#666; margin-bottom:10px;">Digite o código e clique em Verificar para liberar o acesso:</p>
        <div class="verificacao-container">
            <input type="text" id="inputVerificacao" placeholder="Digite o código aqui..." autocomplete="off">
            <button class="btn" onclick="verificarCodigo()" id="btnVerificar">Verificar</button>
        </div>
        <div id="mensagemResultado" class="mensagem-resultado"></div>
    </div>

    <!-- ==================== PÁGINA 1 ==================== -->
    <div id="pagina1" class="hidden">
        <h2 class="p1-titulo-periodo">DADOS DOS ÚLTIMOS 2 MESES</h2>
        <div id="syncIndicator" class="sync-indicator">🟢 Sincronizado agora</div>
        
        <div class="p1-topo">
            <div class="painel-com-rotulo">
                <div class="rotulo-vertical">ESTADO DE CADA SERVIÇO</div>
                <div id="gridStatusCaixas" class="grid-caixas-status">
                    <div class="loading">Carregando contadores...</div>
                </div>
            </div>
            
            <div class="p1-botoes-laterais">
                <button class="btn-p1-lateral" onclick="irParaPagina2()">
                    Mudar Itens ➔
                </button>
                <button class="btn-p1-lateral" onclick="irParaPagina3()">
                    Histórico ➔
                </button>
            </div>
        </div>

        <div class="p1-corpo">
            <div class="p1-corpo-esquerda">
                <div class="painel-com-rotulo">
                    <div class="rotulo-vertical">ESTADO DE CADA PRAZO</div>
                    <div id="gridPrazosCaixas" class="grid-caixas-prazos">
                        <div class="loading">Carregando prazos...</div>
                    </div>
                </div>

                <div class="container-lista-pendentes">
                    <div id="listaPendentesVertical" class="lista-vertical-pendentes">
                        <div class="loading">Carregando tarefas...</div>
                    </div>
                </div>
            </div>

            <!-- VISUALIZAÇÃO DINÂMICA DIVIDIDA EM 2 COLUNAS -->
            <div class="grid-vis-dinamica">
                <!-- Coluna 1: No Prazo / Prazo Próximo -->
                <div class="container-vis-dinamica">
                    <div class="vis-dinamica-titulo" style="color: #2e7d32;">
                        🟢 Dentro do Prazo & Próximo
                    </div>
                    <div class="vis-dinamica-viewport">
                        <div id="trackPrazoOk" class="vis-dinamica-track"></div>
                    </div>
                </div>

                <!-- Coluna 2: Dia Limite / Atrasado -->
                <div class="container-vis-dinamica">
                    <div class="vis-dinamica-titulo" style="color: #c62828;">
                        🔴 Prazo Limite & Atrasado
                    </div>
                    <div class="vis-dinamica-viewport">
                        <div id="trackPrazoCritico" class="vis-dinamica-track"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ==================== PÁGINA 2 ==================== -->
    <div id="pagina2" class="hidden">
        <div style="margin-bottom: 15px; display: flex; justify-content: flex-end;">
            <button class="btn btn-secondary" onclick="irParaPagina1()">⬅️ Voltar à 1ª Página</button>
        </div>

        <div id="conteudoProtegido" class="app-layout">
            <!-- Tarefas Em Andamento -->
            <div id="secaoTarefas" class="section area-tarefas">
                <div class="section-header"><h2>📌 Tarefas em Andamento</h2></div>
                <div class="seletor-container">
                    <label for="selectTarefas">Selecione uma tarefa:</label>
                    <select id="selectTarefas" onchange="mostrarDetalhesTarefa()">
                        <option value="">-- Escolha uma tarefa --</option>
                    </select>
                </div>
                <div id="tarefasLoading" class="loading" style="display:none;">Carregando tarefas...</div>
                <div id="tarefasError" class="error" style="display:none;"></div>
                <div id="detalhesTarefa" class="detalhes-card" style="display:none;"></div>
            </div>

            <!-- Adicionar Elemento -->
            <div id="secaoAdicionar" class="section area-adicionar">
                <div class="section-header"><h2>➕ Adicionar Elemento</h2></div>
                <p style="color:#666; margin-bottom:20px;">Crie um novo elemento para uma das listas existentes:</p>
                <div class="form-group">
                    <label for="tipoElemento">Tipo de Elemento:</label>
                    <select id="tipoElemento" onchange="atualizarFormulario()">
                        <option value="">-- Selecione o tipo --</option>
                        <option value="tarefa">📌 Tarefa</option>
                        <option value="integrador">🛠️ Integrador</option>
                    </select>
                </div>

				<!-- Form Tarefa -->
				<div id="formTarefa" class="hidden">
					<div class="form-group"><label for="nomeTarefa">Nome da Tarefa:</label><input type="text" id="nomeTarefa" placeholder="Ex: CASA 10"></div>
					<div class="form-group"><label for="tipoTarefa">Tipo:</label><input type="text" id="tipoTarefa" placeholder="Ex: Instalação solar"></div>
					<div class="form-group">
						<label for="statusTarefa">Status:</label>
						<select id="statusTarefa">
							<option value="">-- Selecione o status --</option>
							<option value="concluído">✅ Concluído</option>
							<option value="em progresso">⏩ Em progresso</option>
							<option value="aguardando equatorial">⏳ Aguardando Equatorial</option>
							<option value="faltam dados">🗂️ Faltam dados necessários</option>
							<option value="reprovado pela equatorial">❕ Reprovado pela Equatorial</option>
							<option value="não iniciado">❌ Não iniciado</option>
						</select>
					</div>
					<div class="form-group"><label for="enderecoTarefa">Endereço:</label><input type="text" id="enderecoTarefa" placeholder="Ex: Av. Central, 123 - Centro"></div>
					<div class="form-group"><label for="dataInicioObraTarefa">Data de Início da Obra:</label><input type="date" id="dataInicioObraTarefa"></div>
					<div class="form-group"><label for="dataEsperadaTarefa">Data Esperada para Entrega:</label><input type="date" id="dataEsperadaTarefa"></div>
					<div class="form-group"><label for="integradorTarefa">Integrador Associado:</label><select id="integradorTarefa"><option value="">-- Selecione o integrador --</option></select></div>
					<div class="form-group">
						<label for="statusMaterialTarefa">Status do Material:</label>
						<select id="statusMaterialTarefa">
							<option value="">-- Selecione o status do material --</option>
							<option value="Falta">❌ Falta</option>
							<option value="Arranjado">✅ Arranjado</option>
						</select>
					</div>
					<div class="form-group"><label for="materiaisFaltandoTarefa">Materiais Faltando (digite um por linha):</label><textarea id="materiaisFaltandoTarefa" placeholder="Ex: Cabo 10mm&#10;Inversor 5kW&#10;Disjuntor 32A"></textarea></div>
					<div class="form-group"><label for="pendenciasTarefa">Pendências a Resolver:</label><textarea id="pendenciasTarefa" placeholder="Descreva em detalhes as pendências do caso..."></textarea></div>
					<div class="form-group"><label for="relatorioAtividadesTarefa">Relatório de Atividades Desenvolvidas:</label><textarea id="relatorioAtividadesTarefa" placeholder="Relatório de atividades diárias..."></textarea></div>
					<div class="form-group"><label for="descricaoTarefa">Descrição Geral:</label><textarea id="descricaoTarefa" placeholder="Descreva a tarefa..."></textarea></div>
					<button class="btn btn-success" onclick="adicionarTarefa()" id="btnAdicionarTarefa">Adicionar Tarefa</button>
				</div>

                <!-- Form Integrador -->
                <div id="formIntegrador" class="hidden">
                    <div class="form-group"><label for="nomeIntegrador">Nome do Integrador:</label><input type="text" id="nomeIntegrador" placeholder="Ex: João"></div>
                    <div class="form-group"><label for="ncpfIntegrador">nº do CPF:</label><input type="text" id="ncpfIntegrador" placeholder="Ex: 123456789" maxlength="15"></div>
                    <button class="btn btn-success" onclick="adicionarIntegrador()" id="btnAdicionarIntegrador">Adicionar Integrador</button>
                </div>

                <div id="mensagemAdicionar" style="margin-top:15px;"></div>
            </div>

            <!-- Integradores -->
            <div id="secaoIntegradores" class="section area-integradores">
                <div class="section-header"><h2>🛠️ Integradores</h2></div>
                <div class="seletor-container">
                    <label for="selectIntegradores">Selecione um integrador:</label>
                    <select id="selectIntegradores" onchange="mostrarDetalhesIntegrador()">
                        <option value="">-- Escolha um integrador --</option>
                    </select>
                </div>
                <div id="integradoresLoading" class="loading" style="display:none;">Carregando integradores...</div>
                <div id="integradoresError" class="error" style="display:none;"></div>
                <div id="detalhesIntegrador" class="detalhes-card" style="display:none;"></div>
            </div>
