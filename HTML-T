function obterPesoOrdem(t) {
    const status = (t.status || '').toLowerCase();
    
    // REGRA 1: Tarefas concluídas vão FORÇADAMENTE para o final da lista (peso máximo)
    if (status.includes('conclu')) return 10;

    if (!t.data_para_termino) return 9; // Sem data fica logo acima das concluídas

    const [ano, mes, dia] = t.data_para_termino.split('T')[0].split('-');
    const dataTermino = new Date(ano, mes - 1, dia);
    const hoje = new Date(); 
    hoje.setHours(0, 0, 0, 0);

    const diffDias = Math.round((dataTermino.getTime() - hoje.getTime()) / (1000 * 60 * 60 * 24));

    // REGRA 2: Ordem de urgência para as tarefas NÃO concluídas
    if (diffDias < 0) return 1;   // 🔴 Atrasado
    if (diffDias < 2) return 2;   // 🚨 No Limite
    if (diffDias <= 8) return 3;  // ⚠️ Próximo
    return 4;                     // 🟢 No Prazo
}

function renderizarListaPendentes() {
    const container = document.getElementById('listaPendentesVertical');

    if (!dadosTarefas || dadosTarefas.length === 0) {
        container.innerHTML = '<p style="color:#666; text-align:center;">🎉 Nenhuma tarefa cadastrada no momento!</p>';
        return;
    }

    const tarefasOrdenadas = [...dadosTarefas].sort((a, b) => {
        const pesoA = obterPesoOrdem(a);
        const pesoB = obterPesoOrdem(b);

        // Separa por grupo (Atrasado -> No Limite -> Próximo -> No Prazo -> Concluído)
        if (pesoA !== pesoB) {
            return pesoA - pesoB;
        }

        // Desempate dentro do mesmo grupo: data mais antiga/próxima primeiro
        if (a.data_para_termino && b.data_para_termino) {
            return new Date(a.data_para_termino) - new Date(b.data_para_termino);
        }
        return 0;
    });

    container.innerHTML = tarefasOrdenadas.map(t => {
        const s = (t.status || '').toLowerCase();
        const isConcluido = s.includes('conclu');
        const emoji = getEmojiStatus(t.status);
        
        const bgCor = isConcluido ? '#2196f3' : getCorPrazo(t.data_para_termino);
        const dataFormatada = formatarData(t.data_para_termino);
        const rotuloData = isConcluido ? 'Terminado' : 'Até';

        return `
            <div class="item-pendente" style="background-color: ${bgCor};">
                <div class="item-pendente-esquerda">
                    <span>${emoji}</span>
                    <span>${t.nome}</span>
                </div>
                <span>${rotuloData}: ${dataFormatada}</span>
            </div>
        `;
    }).join('');
}

function getTextoStatusSemFundo(status) {
    if (!status) return 'Não definido';
    const s = status.toLowerCase();
    if (s.includes('conclu')) return `✅ ${status}`;
    if (s.includes('progresso')) return `⏩ ${status}`;
    if (s.includes('reprovado')) return `❕ ${status}`;
    if (s.includes('equatorial')) return `⏳ ${status}`;
    if (s.includes('faltam')) return `🗂️ ${status}`;
    if (s.includes('não iniciado') || s.includes('nao iniciado')) return `❌ ${status}`;
    return status;
}

function getTextoPrazoSemFundo(dataISO) {
    if (!dataISO) return '';
    const [ano, mes, dia] = dataISO.split('T')[0].split('-');
    const dataTermino = new Date(ano, mes - 1, dia);
    const hoje = new Date(); hoje.setHours(0, 0, 0, 0);
    const diffDias = Math.round((dataTermino.getTime() - hoje.getTime()) / (1000 * 60 * 60 * 24));

    if (diffDias > 8) return '🟢 No prazo';
    if (diffDias >= 2) return '⚠️ PRAZO PRÓXIMO';
    if (diffDias >= 0) return '🚨 DIA LIMITE';
    return '❌ ATRASADO';
}

function renderizarVisualizacaoDinamicaVertical() {
    const trackOk = document.getElementById('trackPrazoOk');
    const trackCritico = document.getElementById('trackPrazoCritico');

    if (!trackOk || !trackCritico) return;

    if (!dadosTarefas || dadosTarefas.length === 0) {
        trackOk.innerHTML = '<p style="text-align:center; color:#666; padding:10px;">Sem dados.</p>';
        trackCritico.innerHTML = '<p style="text-align:center; color:#666; padding:10px;">Sem dados.</p>';
        return;
    }

    const hoje = new Date();
    hoje.setHours(0, 0, 0, 0);

    const pendentes = dadosTarefas.filter(t => {
        const s = (t.status || '').toLowerCase();
        return s !== 'concluído' && s !== 'concluido';
    });

    const cardsOk = [];
    const cardsCritico = [];

    pendentes.forEach(t => {
        const cardHtml = `
            <div class="vis-card">
                <h4>${t.nome}</h4>
                <p><b>Status:</b> ${getTextoStatusSemFundo(t.status)}</p>
                <p><b>Data:</b> ${formatarData(t.data_para_termino)} - ${getTextoPrazoSemFundo(t.data_para_termino)}</p>
            </div>
        `;

        if (t.data_para_termino) {
            const [ano, mes, dia] = t.data_para_termino.split('T')[0].split('-');
            const dataTermino = new Date(ano, mes - 1, dia);
            const diffDias = Math.round((dataTermino.getTime() - hoje.getTime()) / (1000 * 60 * 60 * 24));

            if (diffDias >= 2) {
                cardsOk.push(cardHtml);
            } else {
                cardsCritico.push(cardHtml);
            }
        } else {
            cardsOk.push(cardHtml);
        }
    });

    if (cardsOk.length > 0) {
        const html = cardsOk.join('');
        trackOk.innerHTML = html + html;
        const tempo = Math.max(10, cardsOk.length * 4);
        trackOk.style.setProperty('--animation-duration-v', `${tempo}s`);
    } else {
        trackOk.innerHTML = '<p style="text-align:center; color:#666; padding:15px; font-size:0.85rem;">Sem tarefas regulares.</p>';
    }

    if (cardsCritico.length > 0) {
        const html = cardsCritico.join('');
        trackCritico.innerHTML = html + html;
        const tempo = Math.max(10, cardsCritico.length * 4);
        trackCritico.style.setProperty('--animation-duration-v', `${tempo}s`);
    } else {
        trackCritico.innerHTML = '<p style="text-align:center; color:#666; padding:15px; font-size:0.85rem;">Sem tarefas críticas ou atrasadas.</p>';
    }
}

