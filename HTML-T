        if (valorAtual && valorAtual === integrador.id) opt.selected = true;
        select.appendChild(opt);
    });
}

function getIntegradorBadge(integradorId) {
    const integrador = dadosIntegradores.find(i => i.id === integradorId);
    if (!integrador) return '<span class="badge" style="background:#9e9e9e;">Não definido</span>';
    return `<span class="badge" style="background:#00bcd4;">👤 ${integrador.nome}</span>`;
}

function formatarData(dataISO) {
    if (!dataISO) return 'Não definida';
    const partes = dataISO.split('T')[0].split('-');
    if (partes.length < 3) return dataISO;
    
    const [ano, mes, dia] = partes;
    return `${dia}/${mes}/${ano}`;
}

function obterDataHojeLocal() {
    const hoje = new Date();
    const ano = hoje.getFullYear();
    const mes = String(hoje.getMonth() + 1).padStart(2, '0');
    const dia = String(hoje.getDate()).padStart(2, '0');
    return `${ano}-${mes}-${dia}`;
}

function getStatusBadge(status) {
    if (!status) return '<span class="status-badge status-nao-iniciado">Não definido</span>';
    const s = status.toLowerCase();
    if (s === 'concluído' || s === 'concluido') return `<span class="status-badge status-concluido">✅ ${status}</span>`;
    if (s === 'em progresso') return `<span class="status-badge status-em-progresso">⏩ ${status}</span>`;
    if (s === 'aguardando equatorial') return `<span class="status-badge status-aguardando">⏳ ${status}</span>`;
    if (s === 'reprovado') return `<span class="status-badge status-reprovado">❕ ${status}</span>`;
    if (s === 'faltam dados') return `<span class="status-badge status-faltam-dados">🗂️ ${status}</span>`;
    return `<span class="status-badge status-nao-iniciado">❌ ${status}</span>`;
}

