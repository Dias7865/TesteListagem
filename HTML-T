function getCorPorStatus(status) {
    if (!status) return { bg: '#f9f9f9', text: '#1a1a1a' };
    const s = status.toLowerCase();
    if (s.includes('conclu')) return { bg: '#2196f3', text: '#ffffff' };
    if (s.includes('progresso')) return { bg: '#ff9800', text: '#ffffff' };
    if (s.includes('aguardando')) return { bg: '#1800a1', text: '#ffffff' };
    if (s.includes('faltam')) return { bg: '#00a889', text: '#ffffff' };
    if (s.includes('não iniciado') || s.includes('nao iniciado')) return { bg: '#4f0b06', text: '#ffffff' };
    return { bg: '#e0e0e0', text: '#333333' };
}

function getEmojiStatus(status) {
    if (!status) return '❌';
    const s = status.toLowerCase();
    if (s.includes('conclu')) return '✅';
    if (s.includes('progresso')) return '⏩';
    if (s.includes('aguardando')) return '⏳';
    if (s.includes('faltam')) return '🗂️';
    if (s.includes('não iniciado') || s.includes('nao iniciado')) return '❌';
    return '📌';
}

function getCorPrazo(dataISO) {
    if (!dataISO) return '#757575';
    const [ano, mes, dia] = dataISO.split('T')[0].split('-');
    const dataTermino = new Date(ano, mes - 1, dia);
    const hoje = new Date(); hoje.setHours(0, 0, 0, 0);
    const diffDias = Math.round((dataTermino.getTime() - hoje.getTime()) / (1000 * 60 * 60 * 24));

    if (diffDias > 8) return '#4caf50';
    if (diffDias >= 2) return '#ffc229';
    if (diffDias >= 0) return '#80004c';
    return '#d32f2f';
}

function renderizarCaixasStatus() {
    const container = document.getElementById('gridStatusCaixas');
    if (!dadosIntensidades || dadosIntensidades.length === 0) {
        container.innerHTML = '<p>Nenhuma intensidade cadastrada.</p>';
        return;
    }

    const intensidadesFiltradas = dadosIntensidades.filter(item => 
        !item.status_nome.toLowerCase().includes('atrasad')
    );

    container.innerHTML = intensidadesFiltradas.map(item => {
        const cores = getCorPorStatus(item.status_nome);
        const emoji = getEmojiStatus(item.status_nome);
        return `
            <div class="item-caixa-status">
                <div class="caixa-quantidade" style="background-color: ${cores.bg}; color: ${cores.text};">
                    ${item.valor_intensidade}
                </div>
                <div class="nome-status-caixa">${emoji} ${item.status_nome}</div>
            </div>
        `;
    }).join('');
}

function renderizarCaixasPrazos() {
    const container = document.getElementById('gridPrazosCaixas');
    
    const contadoresPrazos = {
        'dentro do prazo': 0,
        'prazo próximo': 0,
        'no limite': 0,
        'atrasado': 0
    };

    const hoje = new Date();
    hoje.setHours(0, 0, 0, 0);

    dadosTarefas.forEach(t => {
        const s = (t.status || '').toLowerCase();
        if (s !== 'concluído' && s !== 'concluido' && t.data_para_termino) {
            const [ano, mes, dia] = t.data_para_termino.split('T')[0].split('-');
            const dataTermino = new Date(ano, mes - 1, dia);
            const diffDias = Math.round((dataTermino.getTime() - hoje.getTime()) / (1000 * 60 * 60 * 24));

            if (diffDias > 8) contadoresPrazos['dentro do prazo']++;
            else if (diffDias >= 2) contadoresPrazos['prazo próximo']++;
            else if (diffDias >= 0) contadoresPrazos['no limite']++;
            else contadoresPrazos['atrasado']++;
        }
    });

    const listaPrazos = [
        { label: 'Dentro Do Prazo', qtd: contadoresPrazos['dentro do prazo'], bg: '#4caf50' },
        { label: 'Prazo Próximo', qtd: contadoresPrazos['prazo próximo'], bg: '#ffc229' },
        { label: 'No Limite', qtd: contadoresPrazos['no limite'], bg: '#80004c' },
        { label: 'Atrasado', qtd: contadoresPrazos['atrasado'], bg: '#d32f2f' }
    ];

    container.innerHTML = listaPrazos.map(item => `
        <div class="item-caixa-prazo">
            <div class="caixa-quantidade" style="background-color: ${item.bg}; color: #ffffff;">
                ${item.qtd}
            </div>
            <div class="nome-prazo-caixa">${item.label}</div>
        </div>
    `).join('');
}

function renderizarListaPendentes() {
    const container = document.getElementById('listaPendentesVertical');
    const pendentes = dadosTarefas.filter(t => {
        const s = (t.status || '').toLowerCase();
        return s !== 'concluído' && s !== 'concluido';
    });

    if (pendentes.length === 0) {
        container.innerHTML = '<p style="color:#666; text-align:center;">🎉 Nenhuma tarefa pendente no momento!</p>';
        return;
    }

    container.innerHTML = pendentes.map(t => {
        const emoji = getEmojiStatus(t.status);
        const bgCor = getCorPrazo(t.data_para_termino);
        const dataFormatada = formatarData(t.data_para_termino);

        return `
            <div class="item-pendente" style="background-color: ${bgCor};">
                <div class="item-pendente-esquerda">
                    <span>${emoji}</span>
                    <span>${t.nome}</span>
                </div>
                <span>Até: ${dataFormatada}</span>
            </div>
        `;
    }).join('');
}

function getTextoStatusSemFundo(status) {
    if (!status) return 'Não definido';
    const s = status.toLowerCase();
    if (s.includes('concl')) return `✅ ${status}`;
    if (s.includes('progresso')) return `⏩ ${status}`;
    if (s.includes('equatorial')) return `⏳ ${status}`;
    if (s.includes('faltam')) return `🗂️ ${status}`;
    if (s.includes('não iniciado') || s.includes('nao iniciado')) return `❌ ${status}`;
    return status;
}

function getTextoPrazoSemFundo(dataISO) {
    if (!dataISO) return '';
    const [ano, mes, dia] = dataISO.split('T')[0].split('-');
    const dataTermino = new Date(ano, mes - 1, dia);
    const hoje = new Date(); hoje.setHours(0, 0, 0, 0);
    const diffDias = Math.round((dataTermino.getTime() - hoje.getTime()) / (1000 * 60 * 60 * 24));

    if (diffDias > 8) return '🟢 No prazo';
    if (diffDias >= 2) return '⚠️ PRAZO PRÓXIMO';
    if (diffDias >= 0) return '🚨 DIA LIMITE';
    return '❌ ATRASADO';
}

function renderizarVisualizacaoDinamicaVertical() {
    const track = document.getElementById('visDinamicaTrack');
    if (!dadosTarefas || dadosTarefas.length === 0) {
        track.innerHTML = '<p style="text-align:center; color:#666;">Sem dados para exibir.</p>';
        return;
    }

    const cardsHTML = dadosTarefas.map(t => `
        <div class="vis-card">
            <h4>${t.nome}</h4>
            <p><b>Status:</b> ${getTextoStatusSemFundo(t.status)}</p>
            <p><b>Data:</b> ${formatarData(t.data_para_termino)} - ${getTextoPrazoSemFundo(t.data_para_termino)}</p>
        </div>
    `).join('');

    track.innerHTML = cardsHTML + cardsHTML;
    const tempoTotal = Math.max(12, dadosTarefas.length * 5);
    track.style.setProperty('--animation-duration-v', `${tempoTotal}s`);
}

